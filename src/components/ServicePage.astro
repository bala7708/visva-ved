---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import BookingModal from "./BookingModal.astro";

interface CoreItem {
  symbol?: string;
  icon?: string;
  name: string;
  subtitle?: string;
  text: string;          // a "\n" starts a new line
  color?: string;
}

interface Props {
  title: string;
  description: string;
  hero: {
    eyebrow: string;
    title: string;
    subtitle: string;
    pattern?: string[];
    image?: ImageMetadata;
    tint?: string;
    opacity?: number;
    shade?: boolean;
  };
  intro: {
    eyebrow: string;
    title: string;
    paragraphs: string[];
    image: ImageMetadata;
    alt: string;
    reverse?: boolean;
    ratio?: string;
    badge?: string;
  };
  rooted?: {
    title: string;
    text: string;
    highlight?: string;
  };
  core: {
    eyebrow?: string;
    title: string;
    intro?: string;
    variant?: "directions" | "talks" | "energy" | "elements";   // NEW: "elements" (Vastu)
    items: CoreItem[];
  };
  discover?: {
    eyebrow: string;
    title: string;
    items: { title: string; text: string }[];
    numbered?: boolean;
    rows?: boolean;
    cta: string;
    programme?: string;
    href?: string;
  };
  faq?: {
    title: string;
    items: { question: string; answer: string }[];
  };
  prev?: { label: string; href: string };
  next?: { label: string; href: string };
}

const { title, description, hero, intro, rooted, core, discover, faq, prev, next } = Astro.props;

const heroStyle = [
  hero.tint ? `--hero-bg: ${hero.tint}` : "",
  hero.opacity !== undefined ? `--hero-opacity: ${hero.opacity}` : "",
].filter(Boolean).join("; ");
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <!-- 1. Hero -->
    <section
      class:list={["page-hero", { "page-hero--photo": hero.image, "page-hero--shade": hero.shade }]}
      style={heroStyle || undefined}
    >
      {hero.image && (
        <div class="hero-photo" aria-hidden="true">
          <Image src={hero.image} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
        </div>
      )}
      {hero.pattern && (
        <div class="pattern" aria-hidden="true">
          {hero.pattern.map((row) => <span>{row}</span>)}
        </div>
      )}
      <div class="page-hero-content">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <span class="hero-line" aria-hidden="true"></span>
        <p class="hero-subtitle">{hero.subtitle}</p>
      </div>
    </section>

    <!-- 2. Introduction -->
    <section class="section">
      <div class:list={["container", "intro", { "intro--reverse": intro.reverse }]}>
        <div class="intro-text">
          <p class="eyebrow">{intro.eyebrow}</p>
          <h2>{intro.title}</h2>
          {intro.paragraphs.map((text) => <p>{text}</p>)}
        </div>
        <div
          class:list={["intro-media", { "intro-media--arch": intro.badge }]}
          style={`--ratio: ${intro.ratio ?? "1"}`}
        >
          <Image src={intro.image} alt={intro.alt} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 544px" />
          {intro.badge && <span class="intro-badge" aria-hidden="true">{intro.badge}</span>}
        </div>
      </div>
    </section>

    <!-- 3. Rooted (optional) -->
    {rooted && (
      <section class="rooted">
        <div class="rooted-inner">
          <h2>{rooted.title}</h2>
          <p>
            {rooted.text}
            {rooted.highlight && (<><br /><strong>{rooted.highlight}</strong></>)}
          </p>
        </div>
      </section>
    )}

    <!-- 4. Core cards -->
    <section
      id="core"
      class:list={[
        "section",
        "core",
        {
          "core--talks": core.variant === "talks",
          "core--energy": core.variant === "energy",
          "core--elements": core.variant === "elements",
        },
      ]}
    >
      <div class="container core-inner">
        {core.eyebrow && <p class="eyebrow">{core.eyebrow}</p>}
        <h2>{core.title}</h2>
        {core.intro && <p class="core-intro">{core.intro}</p>}
        <ul class:list={[
          "core-grid",
          {
            "core-grid--directions": core.variant === "directions",
            "core-grid--talks": core.variant === "talks",
            "core-grid--energy": core.variant === "energy",
            "core-grid--elements": core.variant === "elements",
          },
        ]}>
          {core.items.map((item) => (
            <li class="core-card" style={item.color ? `--accent: ${item.color}` : undefined}>
              {item.icon && (
                <svg class="core-icon" viewBox="0 0 24 24" width="24" height="24" fill="none"
                     stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true" set:html={item.icon} />
              )}
              {item.symbol && <span class="core-symbol">{item.symbol}</span>}
              <h3>{item.name}</h3>
              {item.subtitle && <p class="core-subtitle">{item.subtitle}</p>}
              <p class="core-text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. What You Will Discover (optional) -->
    {discover && (
      <section id="discover" class="section">
        <div class="container discover-inner">
          <p class="eyebrow">{discover.eyebrow}</p>
          <h2>{discover.title}</h2>
          <ul class:list={[
            "discover-list",
            { "discover-list--steps": discover.numbered, "discover-list--rows": discover.rows },
          ]}>
            {discover.items.map((item, i) => (
              <li>
                {discover.numbered && (
                  <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                )}
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </li>
            ))}
          </ul>
          {discover.href ? (
            <a class="btn btn--green" href={discover.href}>
              {discover.cta} <span aria-hidden="true">→</span>
            </a>
          ) : (
            <a class="btn btn--green" href="#book" data-programme={discover.programme}>
              {discover.cta} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </section>
    )}

    <!-- 6. FAQ (optional) -->
    {faq && (
      <section id="faq" class="faq">
        <h2>{faq.title}</h2>
        <div class="faq-list">
          {faq.items.map((item) => (
            <div class="faq-card">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 7. Page navigation (optional) -->
    {prev && next && (
      <div class="page-nav-wrap">
        <nav class="container page-nav" aria-label="More sciences">
          <a class="nav-prev" href={prev.href}><span aria-hidden="true">←</span> {prev.label}</a>
          <a class="nav-next" href={next.href}>{next.label} <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    )}
  </main>

  <Footer />
  <BookingModal />
</BaseLayout>

<style>
  /* ---------- 1. Hero ---------- */
  .page-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 517px;
    padding: 80px 24px;
    overflow: hidden;
    background: var(--hero-bg, #1b2a1e);
    text-align: center;
  }
  .page-hero--photo { background: var(--hero-bg, #1c2830); }
  .hero-photo { position: absolute; inset: 0; }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: var(--hero-opacity, 0.3);
  }
  .page-hero--shade::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 14, 8, 0.15) 0%, rgba(20, 14, 8, 0.45) 55%, rgba(20, 14, 8, 0.8) 100%);
  }
  .pattern {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    color: rgba(201, 168, 76, 0.1);
    white-space: nowrap;
    user-select: none;
  }
  .page-hero-content {
    position: relative;
    z-index: 1;
  }
  h1 {
    margin-top: 16px;
    font-size: clamp(2.5rem, 5vw, 3.4rem);
    color: var(--color-cream);
  }
  .hero-line {
    display: block;
    width: 40px;
    height: 1px;
    margin: 28px auto;
    background: var(--color-gold);
  }
  .hero-subtitle {
    max-width: 740px;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(245, 239, 226, 0.85);
  }

  /* ---------- 2. Introduction ---------- */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    max-width: 1148px;
  }
  .intro-text h2 { margin-top: 14px; }
  .intro-text p:not(.eyebrow) {
    margin-top: 20px;
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .intro-text h2 + p { margin-top: 32px; }
  .intro-media { position: relative; margin: 12px; }
  .intro-media::after {
    content: "";
    position: absolute;
    inset: -12px;
    border: 1px solid rgba(201, 168, 76, 0.35);
    pointer-events: none;
  }
  .intro-media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }
  .intro--reverse .intro-media { order: -1; }

  .intro-media--arch { max-width: 446px; justify-self: center; }
  .intro-media--arch::after {
    inset: -24px -10px 10px 14px;
    border-radius: 999px 999px 0 0 / 160px 160px 0 0;
    z-index: -1;
  }
  .intro-badge {
    position: absolute;
    left: -28px;
    bottom: 22px;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border: 1px solid rgba(201, 168, 76, 0.6);
    border-radius: 50%;
    background: #f9f4ec;
    box-shadow: 0 6px 16px rgba(30, 46, 32, 0.12);
    font-family: "Cinzel", serif;
    font-size: 18px;
    color: #b8952f;
  }

  /* ---------- 3. Rooted ---------- */
  .rooted {
    padding: 72px 24px;
    background: #ffffff;
    text-align: center;
  }
  .rooted-inner { max-width: 1180px; margin-inline: auto; }
  .rooted h2 {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    color: #5a7a5a;
  }
  .rooted p {
    max-width: 920px;
    margin: 24px auto 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    line-height: 1.9;
    color: #4a5e4b;
  }
  .rooted strong { font-weight: 600; }

  /* ---------- 4. Core cards ---------- */
  .core { background: #e8dfca; }
  .core-inner {
    max-width: 1148px;
    text-align: center;
  }
  .core-inner h2 { margin-top: 14px; }
  .core-intro {
    max-width: 560px;
    margin: 20px auto 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #8a8d7e;
  }
  .core-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 24px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .core-card {
    padding: 28px;
    background: #f3ecdf;
    border: 1px solid rgba(201, 168, 76, 0.2);
  }
  .core-symbol {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.1em;
    color: var(--color-gold);
  }
  .core-card h3 {
    margin-top: 12px;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .core-text {
    margin-top: 12px;
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #8a8d7e;
    white-space: pre-line;
  }

  /* Directions version */
  .core-grid--directions { grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .core-grid--directions .core-card { padding: 24px; }
  .core-icon { color: var(--accent, var(--color-gold)); }
  .core-grid--directions h3 {
    margin-top: 16px;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--accent, var(--color-gold));
  }
  .core-subtitle {
    margin-top: 4px;
    font-style: italic;
    font-size: 0.8rem;
    color: #8a8d7e;
  }
  .core-grid--directions .core-text {
    margin-top: 14px;
    font-family: var(--font-ui);
    font-style: normal;
    font-size: 0.8rem;
    color: var(--color-ink);
  }

  /* Talks version (Numerology) */
  .core--talks { background: #fbf3e2; }
  .core--talks .core-inner h2 { color: #5c3d1e; }
  .core-grid--talks { gap: 24px; margin-top: 56px; }
  .core-grid--talks .core-card {
    min-height: 236px;
    padding: 32px;
    background: #ffffff;
    border: 1px solid #d8cebc;
  }
  .core-grid--talks h3 {
    margin-top: 0;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    line-height: 1.6;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-gold);
    overflow-wrap: anywhere;
  }
  .core-grid--talks .core-text {
    margin-top: 12px;
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.75;
    color: #7a8e7b;
  }

  /* Energy version (Tarot) */
  .core--energy { background: #f7f1e1; }
  .core--energy .core-inner { max-width: 652px; }
  .core--energy .core-inner h2 { color: #5c3d1e; }
  .core-grid--energy {
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: 10px;
    margin-top: 32px;
    text-align: center;
  }
  .core-grid--energy .core-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 128px;
    padding: 24px 14px;
    background: #ffffff;
    border: 1px solid #e3dccb;
  }
  .core-grid--energy h3 {
    margin-top: 0;
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    color: #c9a84c;
  }
  .core-grid--energy .core-text {
    margin-top: 8px;
    font-style: normal;
    font-size: 11.5px;
    line-height: 1.6;
    color: #8a8d7e;
  }

  /* NEW: Elements version (Vastu): gold title, small subtitle, question below */
  .core--elements { background: #f7f1e1; }
  .core--elements .core-inner { max-width: 652px; }
  .core--elements .core-inner h2 { color: #5c3d1e; }
  .core-grid--elements {
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 40px;
  }
  .core-grid--elements .core-card {
    min-height: 142px;
    padding: 30px 16px 26px;
    background: #ffffff;
    border: 1px solid #e3dccb;
  }
  .core-grid--elements h3 {
    margin-top: 0;
    font-family: "Cinzel", serif;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
    color: #c9a84c;
  }
  .core-grid--elements .core-subtitle {
    margin-top: 8px;
    font-family: "Cinzel", serif;
    font-style: normal;
    font-size: 9.5px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    color: #2b2f22;
  }
  .core-grid--elements .core-text {
    margin-top: 22px;
    font-family: "Cinzel", serif;
    font-style: normal;
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.06em;
    color: #a8925a;
  }

  /* ---------- 5. What You Will Discover ---------- */
  .discover-inner {
    max-width: 1108px;
    text-align: center;
  }
  .discover-inner h2 { margin-top: 16px; }
  .discover-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 48px;
    margin: 56px 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .discover-list li {
    padding-left: 22px;
    border-left: 3px solid var(--color-gold);
  }
  .discover-list h3 { font-size: 0.85rem; letter-spacing: 0.04em; }
  .discover-list p {
    margin-top: 10px;
    font-size: 1rem;
    line-height: 1.75;
  }
  .discover-list--steps {
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 920px;
    margin-inline: auto;
  }
  .discover-list--steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: 32px;
    padding-left: 0;
    border-left: 0;
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    text-align: right;
    color: #dcc995;
  }
  .discover-list--rows {
    grid-template-columns: 1fr;
    gap: 14px;
    max-width: 776px;
    margin: 48px auto 20px;
  }
  .discover-list--rows li {
    padding: 22px 24px;
    border: 1px solid #ddd2bd;
    background: #fcfaf5;
  }
  .discover-list--rows li > div {
    display: grid;
    grid-template-columns: 104px 1fr;
    align-items: center;
    column-gap: 24px;
  }
  .discover-list--rows h3 { font-size: 0.8rem; color: var(--color-gold); }
  .discover-list--rows p { margin-top: 0; font-size: 0.9rem; }
  .btn--green {
    padding: 16px 36px;
    border-color: #4f9e62;
    background: linear-gradient(170deg, #5cae6e, #46955a);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(70, 149, 90, 0.35);
  }
  .btn--green:hover { filter: brightness(1.05); }

  /* ---------- 6. FAQ ---------- */
  .faq {
    padding: 54px 24px 96px;
    text-align: center;
  }
  .faq h2 {
    margin-top: 16px;
    font-size: clamp(1.6rem, 3vw, 2rem);
    color: #5a7a5a;
  }
  .faq-list {
    display: grid;
    gap: 16px;
    max-width: 1136px;
    margin: 68px auto 0;
    text-align: left;
  }
  .faq-card {
    padding: 24px;
    background: #ffffff;
    border: 1px solid #d8cebc;
  }
  .faq-card h3,
  .faq-card p {
    font-family: var(--font-faq);
    font-size: 0.875rem;
    line-height: 1.75;
    letter-spacing: 0;
    text-transform: none;
    color: #4a5e4b;
  }
  .faq-card h3 { font-weight: 700; }
  .faq-card p { font-weight: 400; }

  /* ---------- 7. Page navigation ---------- */
  .page-nav-wrap { border-top: 1px solid rgba(30, 46, 32, 0.12); }
  .page-nav {
    display: flex;
    justify-content: space-between;
    padding-block: 56px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
  }
  .nav-prev { color: #8a8f80; transition: color 0.2s; }
  .nav-next { color: #4f9a63; transition: color 0.2s; }
  .nav-prev:hover,
  .nav-next:hover { color: var(--color-saffron-dark); }

  /* ---------- Tablet and phone ---------- */
  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; gap: 56px; }
    .core-grid,
    .core-grid--directions { grid-template-columns: repeat(2, 1fr); }
    .core-grid--energy { grid-template-columns: repeat(2, 1fr); }
    .pattern { font-size: 4rem; }
  }

  @media (max-width: 600px) {
    .page-hero { min-height: 400px; }
    .core-grid,
    .discover-list { grid-template-columns: 1fr; }
    .core-grid--directions { grid-template-columns: repeat(2, 1fr); }
    .core-grid--directions .core-card { padding: 18px; }
    .core-grid--talks .core-card { min-height: 0; padding: 24px; }
    .core-grid--energy,
    .core-grid--elements { grid-template-columns: 1fr; }
    .discover-list { gap: 28px; }
    .discover-list--steps li { grid-template-columns: 40px 1fr; column-gap: 16px; }
    .discover-list--rows { gap: 12px; }
    .discover-list--rows li > div { grid-template-columns: 1fr; row-gap: 6px; }
    .step-num { font-size: 1.8rem; }
    .intro-media { margin: 8px; }
    .intro-media::after { inset: -8px; }
    .intro-media--arch::after { inset: -16px -8px 8px 10px; }
    .intro-badge { left: -8px; width: 60px; height: 60px; font-size: 15px; }
    .rooted, .faq { padding-block: 56px; }
    .faq-list { margin-top: 40px; }
    .faq-card { padding: 20px; }
    .page-nav { font-size: 0.75rem; }
  }
</style>
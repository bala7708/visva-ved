---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import BookingModal from "./BookingModal.astro";

// The "form" each page fills in
interface Props {
  title: string;
  description: string;
  hero: { eyebrow: string; title: string; subtitle: string; pattern: string[] };
  intro: { eyebrow: string; title: string; paragraphs: string[]; image: ImageMetadata; alt: string };
  core: { eyebrow: string; title: string; items: { symbol: string; name: string; text: string }[] };
  discover: {
    eyebrow: string;
    title: string;
    items: { title: string; text: string }[];
    cta: string;
    programme: string;
  };
  prev: { label: string; href: string };
  next: { label: string; href: string };
}

const { title, description, hero, intro, core, discover, prev, next } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <!-- 1. Page hero -->
    <section class="page-hero">
      <div class="pattern" aria-hidden="true">
        {hero.pattern.map((row) => <span>{row}</span>)}
      </div>
      <div class="page-hero-content">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <span class="hero-line" aria-hidden="true"></span>
        <p class="hero-subtitle">{hero.subtitle}</p>
      </div>
    </section>

    <!-- 2. Introduction -->
    <section class="section">
      <div class="container intro">
        <div class="intro-text">
          <p class="eyebrow">{intro.eyebrow}</p>
          <h2>{intro.title}</h2>
          {intro.paragraphs.map((text) => <p>{text}</p>)}
        </div>
        <div class="intro-media">
          <Image src={intro.image} alt={intro.alt} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 544px" />
        </div>
      </div>
    </section>

    <!-- 3. Core cards -->
    <section id="core" class="section core">
      <div class="container core-inner">
        <p class="eyebrow">{core.eyebrow}</p>
        <h2>{core.title}</h2>
        <ul class="core-grid">
          {core.items.map((item) => (
            <li class="core-card">
              <span class="core-symbol">{item.symbol}</span>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. What You Will Discover -->
    <section id="discover" class="section">
      <div class="container discover-inner">
        <p class="eyebrow">{discover.eyebrow}</p>
        <h2>{discover.title}</h2>
        <ul class="discover-list">
          {discover.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
        <a class="btn btn--green" href="#book" data-programme={discover.programme}>
          {discover.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- 5. Page navigation -->
    <nav class="container page-nav" aria-label="More sciences">
      <a href={prev.href}><span aria-hidden="true">←</span> {prev.label}</a>
      <a href={next.href}>{next.label} <span aria-hidden="true">→</span></a>
    </nav>
  </main>

  <Footer />
  <BookingModal />
</BaseLayout>

<style>
  /* ---------- 1. Page hero ---------- */
  .page-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 517px;
    padding: 80px var(--gutter);
    overflow: hidden;
    background: #1b2a1e;
    text-align: center;
  }

  /* Rows of huge, faint symbols in the background */
  .pattern {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    color: rgba(201, 168, 76, 0.1);
    white-space: nowrap;
    user-select: none;
  }

  .page-hero-content { position: relative; }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.5rem, 5vw, 3.4rem);
    color: var(--color-cream);
  }
  .hero-line {
    display: block;
    width: 40px;
    height: 1px;
    margin: 28px auto;
    background: var(--color-gold);
  }
  .hero-subtitle {
    max-width: 640px;
    font-style: italic;
    font-size: 1.1rem;
    color: rgba(245, 239, 226, 0.8);
  }

  /* ---------- 2. Introduction ---------- */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    max-width: calc(1100px + var(--gutter) * 2);
  }
  .intro-text h2 { margin-top: 14px; }
  .intro-text p:not(.eyebrow) {
    margin-top: 20px;
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .intro-text h2 + p { margin-top: 32px; }

  /* The photo, with a thin gold frame offset behind it */
  .intro-media { position: relative; }
  .intro-media::after {
    content: "";
    position: absolute;
    inset: 12px -12px -12px 12px;
    border: 1px solid rgba(201, 168, 76, 0.35);
    z-index: -1;
  }
  .intro-media :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* ---------- 3. Core cards ---------- */
  .core { background: #e8dfca; }
  .core-inner {
    max-width: calc(1100px + var(--gutter) * 2);
    text-align: center;
  }
  .core-inner h2 { margin-top: 14px; }

  .core-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .core-card {
    padding: 28px;
    background: #f3ecdf;
    border: 1px solid rgba(201, 168, 76, 0.2);
  }
  .core-symbol {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-gold);
  }
  .core-card h3 {
    margin-top: 12px;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .core-card p {
    margin-top: 12px;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #7a7d70;
  }

  /* ---------- 4. What You Will Discover ---------- */
  .discover-inner {
    max-width: calc(760px + var(--gutter) * 2);
    text-align: center;
  }
  .discover-inner h2 { margin-top: 14px; }

  .discover-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 32px;
    margin: 48px 0 40px;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .discover-list li {
    padding-left: 16px;
    border-left: 2px solid var(--color-gold);
  }
  .discover-list h3 {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .discover-list p {
    margin-top: 6px;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .btn--green {
    border-color: #3e8a55;
    background: #3e8a55;
    color: #ffffff;
    box-shadow: 0 3px 7px rgba(62, 138, 85, 0.3);
  }
  .btn--green:hover { background: #33744a; }

  /* ---------- 5. Page navigation ---------- */
  .page-nav {
    display: flex;
    justify-content: space-between;
    padding-block: 40px;
    border-top: 1px solid rgba(30, 46, 32, 0.1);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .page-nav a { color: #8a8a7a; transition: color 0.2s; }
  .page-nav a:hover { color: var(--color-saffron-dark); }

  /* ---------- Tablet and phone ---------- */
  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; gap: 48px; }
    .core-grid { grid-template-columns: repeat(2, 1fr); }
    .pattern { font-size: 4rem; }
  }
  @media (max-width: 600px) {
    .page-hero { min-height: 400px; }
    .core-grid,
    .discover-list { grid-template-columns: 1fr; }
    .intro-media::after { inset: 8px -8px -8px 8px; }
  }
</style>
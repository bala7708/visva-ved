---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import BookingModal from "./BookingModal.astro";

interface Props {
  title: string;
  description: string;
  hero: {
    eyebrow: string;
    title: string;
    subtitle: string;
    pattern?: string[];
    image?: ImageMetadata;
  };
  intro: {
    eyebrow: string;
    title: string;
    paragraphs: string[];
    image: ImageMetadata;
    alt: string;
    reverse?: boolean;
    ratio?: string;
  };
  core: { eyebrow: string; title: string; items: { symbol: string; name: string; text: string }[] };
  discover: {
    eyebrow: string;
    title: string;
    items: { title: string; text: string }[];
    numbered?: boolean;
    cta: string;
    programme: string;
  };
  prev: { label: string; href: string };
  next: { label: string; href: string };
}

const { title, description, hero, intro, core, discover, prev, next } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <section class:list={["page-hero", { "page-hero--photo": hero.image }]}>
      {hero.image && (
        <div class="hero-photo" aria-hidden="true">
          <Image src={hero.image} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
        </div>
      )}
      {hero.pattern && (
        <div class="pattern" aria-hidden="true">
          {hero.pattern.map((row) => <span>{row}</span>)}
        </div>
      )}
      <div class="page-hero-content">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <span class="hero-line" aria-hidden="true"></span>
        <p class="hero-subtitle">{hero.subtitle}</p>
      </div>
    </section>

    <section class="section">
      <div class:list={["container", "intro", { "intro--reverse": intro.reverse }]}>
        <div class="intro-text">
          <p class="eyebrow">{intro.eyebrow}</p>
          <h2>{intro.title}</h2>
          {intro.paragraphs.map((text) => <p>{text}</p>)}
        </div>
        <div class="intro-media" style={`--ratio: ${intro.ratio ?? "1"}`}>
          <Image src={intro.image} alt={intro.alt} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 544px" />
        </div>
      </div>
    </section>

    <section id="core" class="section core">
      <div class="container core-inner">
        <p class="eyebrow">{core.eyebrow}</p>
        <h2>{core.title}</h2>
        <ul class="core-grid">
          {core.items.map((item) => (
            <li class="core-card">
              <span class="core-symbol">{item.symbol}</span>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="discover" class="section">
      <div class="container discover-inner">
        <p class="eyebrow">{discover.eyebrow}</p>
        <h2>{discover.title}</h2>
        <ul class:list={["discover-list", { "discover-list--steps": discover.numbered }]}>
          {discover.items.map((item, i) => (
            <li>
              {discover.numbered && (
                <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <a class="btn btn--green" href="#book" data-programme={discover.programme}>
          {discover.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <div class="page-nav-wrap">
      <nav class="container page-nav" aria-label="More sciences">
        <a class="nav-prev" href={prev.href}><span aria-hidden="true">←</span> {prev.label}</a>
        <a class="nav-next" href={next.href}>{next.label} <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </main>

  <Footer />
  <BookingModal />
</BaseLayout>

<style>
  /* ---------- 1. Page hero ---------- */
  .page-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 517px;
    padding: 80px var(--gutter);
    overflow: hidden;
    background: #1b2a1e;
    text-align: center;
  }

  .page-hero--photo {
    background: #1c2830;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .pattern {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    color: rgba(201, 168, 76, 0.1);
    white-space: nowrap;
    user-select: none;
  }

  .page-hero-content {
    position: relative;
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.5rem, 5vw, 3.4rem);
    color: var(--color-cream);
  }

  .hero-line {
    display: block;
    width: 40px;
    height: 1px;
    margin: 28px auto;
    background: var(--color-gold);
  }

  .hero-subtitle {
    max-width: 640px;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(245, 239, 226, 0.8);
  }

  /* ---------- 2. Introduction ---------- */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    max-width: calc(1100px + var(--gutter) * 2);
  }

  .intro-text h2 {
    margin-top: 14px;
  }

  .intro-text p:not(.eyebrow) {
    margin-top: 20px;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .intro-text h2 + p {
    margin-top: 32px;
  }

  .intro-media {
    position: relative;
    margin: 12px;
  }

  .intro-media::after {
    content: "";
    position: absolute;
    inset: -12px;
    border: 1px solid rgba(201, 168, 76, 0.35);
    pointer-events: none;
  }

  .intro-media :global(img) {
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }

  .intro--reverse .intro-media {
    order: -1;
  }

  /* ---------- 3. Core cards ---------- */
  .core {
    background: #e8dfca;
  }

  .core-inner {
    max-width: calc(1100px + var(--gutter) * 2);
    text-align: center;
  }

  .core-inner h2 {
    margin-top: 14px;
  }

  .core-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 24px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .core-card {
    padding: 28px;
    background: #f3ecdf;
    border: 1px solid rgba(201, 168, 76, 0.2);
  }

  .core-symbol {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.1em;
    color: var(--color-gold);
  }

  .core-card h3 {
    margin-top: 12px;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .core-card p {
    margin-top: 12px;
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #8a8d7e;
  }

  /* ---------- 4. What You Will Discover ---------- */
  .discover-inner {
    max-width: calc(1060px + var(--gutter) * 2);
    text-align: center;
  }

  .discover-inner h2 {
    margin-top: 16px;
  }

  /* Default version (Numerology): two columns with a gold line */
  .discover-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 48px;
    margin: 56px 0 56px;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .discover-list li {
    padding-left: 22px;
    border-left: 3px solid var(--color-gold);
  }

  .discover-list h3 {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .discover-list p {
    margin-top: 10px;
    font-size: 1rem;
    line-height: 1.75;
  }

  /* Numbered version (Tarot): one column, big faint numbers on the left */
  .discover-list--steps {
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 920px;
    margin-inline: auto;
  }

  .discover-list--steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: 32px;
    padding-left: 0;
    border-left: 0;
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    text-align: right;
    color: #dcc995;
  }

  .btn--green {
    padding: 16px 36px;
    border-color: #4f9e62;
    background: linear-gradient(170deg, #5cae6e, #46955a);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(70, 149, 90, 0.35);
  }

  .btn--green:hover {
    filter: brightness(1.05);
  }

  /* ---------- 5. Page navigation ---------- */
  .page-nav-wrap {
    border-top: 1px solid rgba(30, 46, 32, 0.12);
  }

  .page-nav {
    display: flex;
    justify-content: space-between;
    padding-block: 56px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
  }

  .nav-prev {
    color: #8a8f80;
    transition: color 0.2s;
  }

  .nav-next {
    color: #4f9a63;
    transition: color 0.2s;
  }

  .nav-prev:hover,
  .nav-next:hover {
    color: var(--color-saffron-dark);
  }

  /* ---------- Tablet and phone ---------- */
  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .core-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pattern {
      font-size: 4rem;
    }
  }

  @media (max-width: 600px) {
    .page-hero {
      min-height: 400px;
    }
    .core-grid,
    .discover-list {
      grid-template-columns: 1fr;
    }
    .discover-list {
      gap: 28px;
    }
    .discover-list--steps li {
      grid-template-columns: 40px 1fr;
      column-gap: 16px;
    }
    .step-num {
      font-size: 1.8rem;
    }
    .intro-media {
      margin: 8px;
    }
    .intro-media::after {
      inset: -8px;
    }
    .page-nav {
      font-size: 0.75rem;
    }
  }
</style>
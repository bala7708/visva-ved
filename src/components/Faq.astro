---
// DRAFT answers: the client must review and approve them before launch.
const faqs = [
  {
    question: "Aren't these just superstitious practices?",
    answer:
      "Numerology, Tarot and Vastu are traditional systems of reflection and design rooted in Vedic thought. We use them as tools for self-understanding and more conscious choices, never to create fear or dependency.",
  },
  {
    question: "Do I need any prior spiritual knowledge?",
    answer:
      "None at all. Every session starts from the basics and is explained in simple, practical terms. All you need is an open mind and a question you'd like to explore.",
  },
  {
    question: "How soon will I see results?",
    answer:
      "Everyone's journey is different. Many people feel greater clarity soon after a session; lasting change grows gradually as the guidance is applied in daily life.",
  },
  {
    question: "Can sessions be done online?",
    answer:
      "Yes. Numerology and Tarot sessions take place online via Google Meet. Vastu consultations can be done online using your floor plan.",
  },
];
---

<section id="faq" class="hfaq">
  <div class="hfaq-inner">
    <h2 class="hfaq-title">I Want to Begin, But…</h2>

    <div class="hfaq-list">
      {faqs.map((item) => (
        <details class="hfaq-item">
          <summary>
            <span>{item.question}</span>
            <span class="hfaq-icon" aria-hidden="true"></span>
          </summary>
          <p class="hfaq-answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .hfaq {
    padding: 80px 24px;
    background: #f7f1e1;
  }

  .hfaq-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .hfaq-title {
    margin: 0;
    font-family: "Cinzel", serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 45px;
    color: #5a7a5a;
    text-align: center;
  }

  .hfaq-list { margin-top: 40px; }

  .hfaq-item { border-bottom: 1px solid rgba(30, 46, 32, 0.15); }

  .hfaq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 18px 0;
    font-family: "Cinzel", serif;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: #1e2e20;
    cursor: pointer;
    list-style: none;
  }
  .hfaq-item summary::-webkit-details-marker { display: none; }
  .hfaq-item summary:hover { color: #d4841a; }

  /* "+" that turns into "×" when open */
  .hfaq-icon {
    position: relative;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    transition: transform 0.25s ease;
  }
  .hfaq-icon::before,
  .hfaq-icon::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: #c9a84c;
  }
  .hfaq-icon::after { transform: rotate(90deg); }
  .hfaq-item[open] .hfaq-icon { transform: rotate(45deg); }

  .hfaq-answer {
    margin: 0;
    padding-bottom: 20px;
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    line-height: 1.8;
    color: #4a5e4b;
  }

  @media (max-width: 600px) {
    .hfaq { padding: 64px 16px; }
    .hfaq-title { font-size: 26px; line-height: 36px; }
  }
</style>
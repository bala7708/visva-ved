---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";

// ① The data: the navigation links. Edit this list to change the menu.
const links = [
  { label: "About", href: "#about" },
  { label: "Programs", href: "#programs" },
  { label: "1:1 Session", href: "#session" },
  { label: "Numerology", href: "#numerology" },
  { label: "Spiritual wellness", href: "#wellness" },
];
---

<!-- ② The HTML: what appears on the page -->
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Visva Ved, back to top">
      <Image src={logo} alt="Visva Ved" width={126} height={96} />
    </a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--gold nav-cta" href="#book">Book a Slot</a>
    </nav>

    <a class="btn btn--gold header-cta" href="#book">Book a Slot</a>

    <button class="menu-toggle" type="button" aria-expanded="false"
            aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- ③ The styles: only apply to this component -->
<style>
  .site-header {
    position: sticky;          /* stays at the top while you scroll */
    top: 0;
    z-index: 50;
    background: var(--color-cream);
    border-bottom: 1px solid rgba(28, 15, 0, 0.06);
  }

  .header-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;   /* keeps the links exactly centered */
    align-items: center;
    height: 80px;
    max-width: 1512px;
    margin-inline: auto;
    padding-inline: 40px;
  }

  .logo { justify-self: start; }
  /* :global() is needed because <Image> is a component */
  .logo :global(img) { width: 63px; height: 48px; object-fit: contain; }

  .nav { display: flex; align-items: center; }
  .nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
    padding: 0;
  }
  .nav ul a {
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.025em;
    color: var(--color-ink);
    transition: color 0.2s;
  }
  .nav ul a:hover { color: var(--color-gold); }

  .header-cta {
    justify-self: end;
    padding: 10px 20px;
    color: var(--color-cream);   /* the Figma design uses cream text here */
  }
  .nav-cta { display: none; }    /* only shown inside the mobile menu */

  /* ☰ button: hidden on desktop */
  .menu-toggle {
    display: none;
    justify-self: end;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }
  /* Turns the ☰ into an ✕ when the menu is open */
  .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ---------- Tablet and mobile ---------- */
  @media (max-width: 900px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      height: 72px;
      padding-inline: var(--gutter);
    }
    .header-cta { display: none; }
    .menu-toggle { display: flex; }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 24px var(--gutter) 32px;
      background: var(--color-cream);
      border-bottom: 1px solid rgba(28, 15, 0, 0.08);
      box-shadow: 0 12px 24px rgba(28, 15, 0, 0.06);
    }
    .nav.is-open { display: flex; }
    .nav ul { flex-direction: column; gap: 20px; }
    .nav ul a { font-size: 1.125rem; }
    .nav-cta { display: inline-flex; color: var(--color-cream); }
  }
</style>

<!-- ④ The JavaScript: opens and closes the mobile menu -->
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("site-nav");

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      nav.classList.toggle("is-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Close the menu after tapping a link, or when pressing Escape
    nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
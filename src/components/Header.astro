---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";

// Navigation links. Edit this list to change the menu.
const links = [
  { label: "Home", href: "/" },
  { label: "Numerology", href: "/numerology" },
  { label: "Tarot", href: "/tarot" },
  { label: "Vastu", href: "/vastu" },
  { label: "Wisdom", href: "/#wisdom" },
];

// Which page are we on? "/numerology/" and "/numerology" both become "/numerology"
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => href === currentPath;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Visva Ved, home">
      <Image src={logo} alt="Visva Ved" width={120} height={92} />
    </a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--saffron nav-cta" href="#book">Book a Session</a>
    </nav>

    <a class="btn btn--saffron header-cta" href="#book">Book a Session</a>

    <button class="menu-toggle" type="button" aria-expanded="false"
            aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffff;
    border-bottom: 1px solid rgba(30, 46, 32, 0.08);
  }

  .header-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;    /* keeps the links exactly centered */
    align-items: center;
    height: 72px;
    max-width: 1512px;
    margin-inline: auto;
    padding-inline: 40px;
  }

  .logo { justify-self: start; }
  .logo :global(img) {
    width: 60px;
    height: 46px;
    object-fit: contain;
  }

  .nav { display: flex; align-items: center; }
  .nav ul {
    display: flex;
    gap: 36px;
    padding: 0;
    list-style: none;
  }
  .nav ul a {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.8125rem;                   /* 13px */
    color: var(--color-ink);
    transition: color 0.2s;
  }
  .nav ul a:hover { color: var(--color-saffron-dark); }
  .nav ul a[aria-current="page"] { color: var(--color-saffron-dark); }

  .header-cta {
    justify-self: end;
    padding: 9px 20px;
  }
  .nav-cta { display: none; }               /* only inside the mobile menu */

  /* ☰ button: hidden on desktop */
  .menu-toggle {
    display: none;
    justify-self: end;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--color-ink);
    transition: transform 0.25s, opacity 0.25s;
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ---------- Tablet and mobile ---------- */
  @media (max-width: 900px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      height: 64px;
      padding-inline: var(--gutter);
    }
    .header-cta { display: none; }
    .menu-toggle { display: flex; }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 24px var(--gutter) 32px;
      background: #ffffff;
      border-bottom: 1px solid rgba(30, 46, 32, 0.08);
      box-shadow: 0 12px 24px rgba(30, 46, 32, 0.06);
    }
    .nav.is-open { display: flex; }
    .nav ul { flex-direction: column; gap: 20px; }
    .nav ul a { font-size: 1rem; }
    .nav-cta { display: inline-flex; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("site-nav");

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      nav.classList.toggle("is-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
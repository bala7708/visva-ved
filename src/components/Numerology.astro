    ],
    image: introPhoto,
    alt: "Golden numbers swirling upwards in a beam of light",
  },

  rooted: {
    title: "Rooted in Chaldean and Cheironian Traditions…",
    text: "Most numerology systems can tell you what is wrong. But diagnosis is only half the journey. At Visva Ved, we engineer the cure by introducing VEDIC NUMEROLOGY as the correctional science, utilising authentic remedies straight from our Vedas, to balance your numerical blueprint.",
    highlight: "Discover the shift from insight to remedy. Align your energy with Visva Ved.",
  },

  core: {
    title: "Number Talks",
    variant: "talks" as const,
    items: [
      { name: "Prianca/Priyanka?", text: "“Name spelling silently sabotaging your destiny? Let’s decode yours today?”" },
      { name: "Baby Says..!!", text: "Bless my journey with a lucky name!" },
      { name: "Opportunities", text: "“Opportunities slipping away despite hard work?”" },
      { name: "Conflicts", text: "“Conflicts ruining relationships?”\n“Act before cracks deepen.”" },
      { name: "Health", text: "“Recurring health issues are not random.”\nAre numbers draining your vitality?" },
      { name: "Signature", text: "Your signature may be sealing your failures?" },
    ],
  },

  faq: {
    title: "Numerology FAQ’s",
    items: [
      {
        question: "How can numbers influence my day-to-day life?",
        answer: "Every number carries a unique vibrational frequency. When your personal numbers clash with the numbers of your home, mobile phone, or current calendar year, it can create unseen friction or delays in your progress.",
      },
      {
        question: "Can Numerology predict my exact future?",
        // TODO: the design cuts this answer off after "times when you": ask the client for the final ending
        answer: "Numerology does not predict absolute destiny; instead, it maps out your “energetic weather forecast.” It highlights peak periods of opportunity, turning points, and times when you may benefit from slowing down and reflecting.",
      },
      {
        question: "Can a minor name correction really change my luck?",
        answer: "Yes. A name correction doesn’t mean changing your legal identity entirely; even a subtle spelling tweak alters the phonetic and mathematical vibration of your name, aligning it harmoniously with your birth date to remove life blocks.",
      },
      {
        question: "What kind of Numerology remedies do you provide?",
        answer: "Our remedies are practical and non-invasive. They include custom name spelling adjustments, signature alignment, recommendations for lucky colours, vedic yantra suggestions, and selecting auspicious dates for major events.",

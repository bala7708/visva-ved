    pattern: [
      "3333333333111111111111111",
      "3333333333333333333333333",
      "1111111122222222222222222",
      "3333333333331111111111111",
    ],
    tint: "linear-gradient(180deg, #1b2a1e 0%, #34523b 55%, #7aa382 100%)",
  },

  intro: {
    eyebrow: "A Dialogue with the Cosmos",
    title: "Living Energies That Shape Your Destiny",
    paragraphs: [
      "Numbers are not mere figures; they are living energies that shape personality, destiny, and cycles of life. Every name carries a vibrational signature; every birth date encodes a cosmic blueprint.",

---
// Ask the client to confirm these numbers before launch.
const stats = [
  { number: "500+", label: "Lives transformed through\nsacred guidance" },
  { number: "3", label: "Ancient sciences\nNumerology, Tarot, Vastu" },
  { number: "3 yrs", label: "Of practice rooted in\nVedic wisdom" },
];
---

<section class="stats-band" aria-label="Visva Ved in numbers">
  <ul class="stats-band-list">
    {stats.map((stat) => (
      <li class="stats-band-item">
        <span class="stats-band-number">{stat.number}</span>
        <span class="stats-band-label">{stat.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Green gradient: light on the left, deep green on the right */
  .stats-band {
    padding: 40px 24px;
    background: linear-gradient(90deg, #5cae6e 0%, #4f9562 45%, #3d6e48 100%);
  }

  .stats-band-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    max-width: 950px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .stats-band-number {
    display: block;
    font-family: "Cinzel", serif;
    font-weight: 500;
    font-size: 44px;
    line-height: 1.1;
    color: #ffffff;
  }

  .stats-band-label {
    display: block;
    margin-top: 10px;
    font-family: "Inter", sans-serif;
    font-weight: 500;
    font-size: 13px;
    line-height: 1.55;
    color: #ffffff;
    white-space: pre-line;          /* "\n" in the label = a new line */
  }

  @media (max-width: 600px) {
    .stats-band-list {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .stats-band-number { font-size: 36px; }
  }
</style>
---
// The booking popup: calendar → details → payment (QR, UTR) → booked.
// Settings (time slots, prices…) live in src/config/booking.mjs.
---

<dialog id="booking-modal" class="booking" aria-labelledby="booking-title">
  <div class="booking-inner">
    <!-- ========== Header ========== -->
    <header class="booking-header">
      <div class="teacher">
        <span class="avatar" aria-hidden="true">VV</span>
        <div>
          <h2 id="booking-title" class="teacher-name">Visva Ved Teacher</h2>
          <p id="booking-meta" class="teacher-meta">Healing Consultation · 45 min</p>
        </div>
      </div>
      <div class="header-actions">
        <span class="meet-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 8-6 4 6 4V8Z" />
            <rect x="2" y="6" width="14" height="12" rx="2" ry="2" />
          </svg>
          Google Meet
        </span>
        <form method="dialog">
          <button class="close" type="submit" aria-label="Close booking">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18" /><path d="m6 6 12 12" />
            </svg>
          </button>
        </form>
      </div>
    </header>

    <!-- ========== 1. Choose a time and enter details ========== -->
    <form id="booking-form" class="booking-form">
      <input type="hidden" id="booking-programme" value="Healing Consultation" />

      <div class="picker">
        <div class="calendar">
          <div class="cal-head">
            <p id="cal-month" class="cal-month" aria-live="polite"></p>
            <div class="cal-nav">
              <button type="button" id="cal-prev" class="icon-btn" aria-label="Previous month">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
              </button>
              <button type="button" id="cal-next" class="icon-btn" aria-label="Next month">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </button>
            </div>
          </div>
          <div class="cal-weekdays" aria-hidden="true">
            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
          </div>
          <div id="cal-grid" class="cal-grid"></div>
        </div>

        <div class="slots">
          <p class="tz">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />
            </svg>
            Asia / Kolkata
          </p>
          <p id="slot-day" class="slot-day">Choose a date</p>
          <div id="slot-list" class="slot-list"></div>
        </div>
      </div>

      <div class="details">
        <p class="details-title">Your Details</p>
        <div class="fields">
          <div class="field">
            <label for="booking-name">Your Name</label>
            <input id="booking-name" type="text" autocomplete="name" placeholder="Priya Sharma" required />
          </div>
          <div class="field">
            <label for="booking-email">Your Email</label>
            <input id="booking-email" type="email" autocomplete="email" placeholder="priya@gmail.com" required />
          </div>
          <div class="field">
            <label for="booking-phone">WhatsApp Number <span class="optional">Optional</span></label>
            <input id="booking-phone" type="tel" autocomplete="tel" placeholder="+91 98765 43210" />
            <label class="consent">
              <input type="checkbox" id="booking-optin" />
              <span>Send me booking updates on WhatsApp</span>
            </label>
          </div>
        </div>

        <button type="submit" id="booking-submit" class="submit" disabled>
          Continue to Payment
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </button>
        <p id="booking-hint" class="hint" aria-live="polite">Select a date and time to continue</p>
      </div>
    </form>

    <!-- ========== 2. Payment ========== -->
    <section id="pay-view" class="pay-view" hidden>
      <p class="pay-eyebrow">Complete your payment</p>
      <p id="pay-amount" class="pay-amount"></p>
      <p id="pay-summary" class="pay-summary"></p>

      <img id="pay-qr" class="pay-qr" alt="UPI QR code for this payment" width="220" height="220" />
      <p class="pay-scan">Scan with any UPI app: Google Pay, PhonePe, Paytm, BHIM…</p>

      <a id="pay-intent" class="btn btn--saffron pay-app-btn" href="#">Pay with UPI app</a>

      <p class="pay-timer">Your slot is held for <strong id="pay-countdown">15:00</strong></p>

      <form id="utr-form" class="utr-form">
        <label for="utr-input">After paying, enter your UPI Transaction ID (UTR)</label>
        <input id="utr-input" type="text" inputmode="numeric" autocomplete="off" maxlength="16"
               placeholder="12-digit number, e.g. 412345678901" required />
        <p class="utr-help">
          You'll find it in your UPI app under the payment details, often called "UTR" or "UPI Ref. No.".
        </p>
        <button id="utr-submit" type="submit" class="btn btn--saffron">Submit Payment Details</button>
        <p id="utr-error" class="utr-error" role="alert"></p>
      </form>

      <p id="pay-status" class="pay-status" aria-live="polite">Waiting for payment…</p>

      <button id="mock-pay-btn" class="mock-btn" type="button" hidden>Simulate payment (test mode)</button>
      <button id="pay-back" class="link-btn" type="button">Choose a different time</button>
    </section>

    <!-- ========== 3a. Booked ========== -->
    <section id="done-view" class="result" hidden>
      <span class="result-icon result-icon--ok" aria-hidden="true">✓</span>
      <h3>Your slot has been booked</h3>
      <p id="done-summary" class="result-summary"></p>
      <p>Further details and links will be sent to your email and WhatsApp. Kindly check.</p>
      <p id="done-note" class="result-note"></p>
      <form method="dialog"><button class="btn btn--saffron" type="submit">Done</button></form>
    </section>

    <!-- ========== 3b. Time ran out ========== -->
    <section id="expired-view" class="result" hidden>
      <span class="result-icon result-icon--wait" aria-hidden="true">⏱</span>
      <h3>Time ran out</h3>
      <p>
        The 15 minutes to complete your booking have passed, so the slot was released.
        If you already paid, please message us on WhatsApp with your UTR, and we'll sort it out.
      </p>
      <button id="expired-retry" class="btn btn--saffron" type="button">Choose another time</button>
    </section>
  </div>
</dialog>

<style>
  /* ---------- Popup box ---------- */
  .booking {
    width: min(780px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: 24px;
    background: #ffffff;
    color: var(--color-text);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }
  .booking::backdrop {
    background: rgba(26, 46, 27, 0.6);
    backdrop-filter: blur(6px);
  }
  .booking[open] { animation: pop-in 0.2s ease-out; }
  @keyframes pop-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
  }
  :global(html:has(dialog.booking[open])) { overflow: hidden; }

  .booking-inner {
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 32px);
  }

  .booking-form[hidden],
  .pay-view[hidden],
  .result[hidden] { display: none; }

  /* ---------- Header ---------- */
  .booking-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 24px 28px;
    border-bottom: 1px solid var(--color-sand);
  }
  .teacher { display: flex; align-items: center; gap: 16px; }
  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-gold), #a8872f);
    color: #ffffff;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.125rem;
  }
  .teacher-name {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .teacher-meta { font-family: var(--font-ui); font-size: 0.875rem; }
  .header-actions { display: flex; align-items: center; gap: 12px; }
  .meet-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border: 1px solid rgba(201, 168, 76, 0.4);
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-ink);
    cursor: pointer;
  }
  .close:hover { background: var(--color-sand); }

  /* ---------- Calendar and slots ---------- */
  .booking-form { overflow-y: auto; font-family: var(--font-ui); }
  .picker {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--color-sand);
  }
  .calendar { padding: 24px 28px; border-right: 1px solid var(--color-sand); }
  .cal-head { display: flex; justify-content: space-between; align-items: center; }
  .cal-month {
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .cal-nav { display: flex; gap: 4px; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-ink);
    cursor: pointer;
  }
  .icon-btn:hover:not(:disabled) { background: var(--color-sand); }
  .icon-btn:disabled { color: #d4c4a8; cursor: default; }

  .cal-weekdays,
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
  .cal-weekdays {
    margin-top: 20px;
    padding-block: 4px;
    font-weight: 500;
    font-size: 0.75rem;
    text-align: center;
  }
  .cal-grid { row-gap: 4px; margin-top: 8px; }
  .cal-grid :global(button) {
    justify-self: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-ink);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .cal-grid :global(button:hover:not(:disabled)) { background: var(--color-sand); }
  .cal-grid :global(button:disabled) { color: #d4c4a8; cursor: default; }
  .cal-grid :global(button[aria-pressed="true"]) {
    background: var(--color-saffron);
    color: #ffffff;
    font-weight: 700;
  }

  .slots { padding: 24px 28px; }
  .tz {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .slot-day { margin-top: 16px; font-weight: 600; color: var(--color-ink); }
  .slot-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 260px;
    margin-top: 16px;
    padding-right: 4px;
    overflow-y: auto;
  }
  .slot-list :global(button) {
    flex-shrink: 0;
    padding: 12px;
    border: 1.5px solid #e8ddd0;
    border-radius: 12px;
    background: #fbf8f2;
    color: var(--color-ink);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .slot-list :global(button:hover:not(:disabled)) { border-color: var(--color-saffron); }
  .slot-list :global(button[aria-pressed="true"]) {
    border-color: var(--color-saffron);
    background: #fdf1d9;
    font-weight: 600;
  }
  .slot-list :global(button:disabled) {
    border-color: #efe9de;
    background: #f5f2ec;
    color: #b9b2a3;
    text-decoration: line-through;
    cursor: not-allowed;
  }
  .slot-list :global(.slot-empty) { font-size: 0.875rem; color: #8a8d7e; }

  /* ---------- Details ---------- */
  .details { padding: 24px 28px; }
  .details-title {
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .fields { display: flex; flex-direction: column; gap: 16px; margin-top: 20px; }
  .field label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .optional {
    padding: 2px 8px;
    border: 1px solid #d4c4a8;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.625rem;
    text-transform: uppercase;
  }
  .field input {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid #e8ddd0;
    border-radius: 12px;
    background: #fbf8f2;
    color: var(--color-ink);
    font-size: 0.875rem;
  }
  .field input:focus { outline: none; border-color: var(--color-saffron); }
  .field .consent {
    align-items: flex-start;
    gap: 10px;
    margin: 10px 0 0;
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--color-text);
    cursor: pointer;
  }
  .field .consent input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    padding: 0;
    accent-color: var(--color-saffron);
  }

  .submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 56px;
    margin-top: 24px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(169deg, var(--color-saffron), var(--color-saffron-dark));
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
  }
  .submit:disabled { background: #d4c4a8; cursor: not-allowed; }
  .hint { margin-top: 8px; font-size: 0.75rem; text-align: center; }

  /* ---------- Payment ---------- */
  .pay-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 28px 36px;
    overflow-y: auto;
    font-family: var(--font-ui);
    text-align: center;
  }
  .pay-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #a8872f;
  }
  .pay-amount {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .pay-summary { max-width: 420px; font-size: 0.9rem; }
  .pay-qr {
    width: 220px;
    height: 220px;
    margin-top: 8px;
    padding: 8px;
    border: 1px solid #e8ddd0;
    background: #ffffff;
  }
  .pay-scan { font-size: 0.8rem; color: #8a8d7e; }
  @media (hover: hover) and (pointer: fine) {
    .pay-app-btn { display: none; }
  }
  .pay-timer { margin-top: 8px; font-size: 0.875rem; }
  .pay-timer strong { font-variant-numeric: tabular-nums; color: var(--color-saffron-dark); }
  .pay-status { font-size: 0.85rem; color: #6b725f; }

  .utr-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(380px, 100%);
    margin-top: 12px;
    padding: 20px;
    border: 1px solid #e8ddd0;
    border-radius: 12px;
    background: #fbf8f2;
    text-align: left;
  }
  .utr-form label { font-weight: 600; font-size: 0.85rem; color: var(--color-ink); }
  .utr-form input {
    padding: 12px 14px;
    border: 1.5px solid #e8ddd0;
    border-radius: 10px;
    background: #ffffff;
    font-size: 1rem;
    letter-spacing: 0.08em;
  }
  .utr-form input:focus { outline: none; border-color: var(--color-saffron); }
  .utr-help { font-size: 0.75rem; color: #8a8d7e; }
  .utr-form .btn { margin-top: 4px; }
  .utr-error { min-height: 1em; font-size: 0.8rem; color: #b3261e; }

  .mock-btn {
    padding: 8px 14px;
    border: 1px dashed var(--color-gold);
    background: #fff8e6;
    color: var(--color-ink);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .mock-btn[hidden] { display: none; }
  .link-btn {
    border: 0;
    background: none;
    color: #6b725f;
    font-size: 0.8rem;
    text-decoration: underline;
    cursor: pointer;
  }

  /* ---------- Results ---------- */
  .result {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 56px 28px;
    font-family: var(--font-ui);
    text-align: center;
  }
  .result h3 { font-size: 1.6rem; }
  .result p { max-width: 420px; }
  .result-summary { font-weight: 500; color: var(--color-ink); }
  .result-note { font-size: 0.85rem; color: #6b725f; }
  .result-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    color: #ffffff;
    font-size: 1.5rem;
  }
  .result-icon--ok { background: #46955a; }
  .result-icon--wait { background: var(--color-gold); }
  .result .btn { margin-top: 12px; }

  /* ---------- Phone ---------- */
  @media (max-width: 640px) {
    .booking-header { align-items: flex-start; padding: 20px; }
    .avatar { width: 44px; height: 44px; font-size: 1rem; }
    .meet-badge { display: none; }
    .picker { grid-template-columns: 1fr; }
    .calendar { padding: 20px; border-right: 0; border-bottom: 1px solid var(--color-sand); }
    .slots, .details { padding: 20px; }
    .slot-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      max-height: none;
      padding-right: 0;
    }
    .slot-list :global(button) { padding: 10px 4px; font-size: 0.8125rem; }
    .slot-list :global(.slot-empty) { grid-column: 1 / -1; }
  }
</style>

<script>
  import QRCode from "qrcode";
  import {
    TIME_SLOTS,
    CLOSED_WEEKDAYS,
    MIN_DAYS_AHEAD,
    MONTHS_SHOWN,
    DEFAULT_PROGRAMME,
    formatTime,
  } from "../config/booking.mjs";

  const API = "/.netlify/functions";

  type Hold = {
    date: string;
    time: string;
    amount: number;
    expiresAt: number;
    holdToken: string;
    orderId: string;
    qrData: string;
    intentUrl: string;
    programme: string;
  };

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const dialog = document.getElementById("booking-modal") as HTMLDialogElement | null;

  if (dialog) {
    // Views
    const form = byId<HTMLFormElement>("booking-form");
    const payView = byId<HTMLElement>("pay-view");
    const doneView = byId<HTMLElement>("done-view");
    const expiredView = byId<HTMLElement>("expired-view");

    // Step 1
    const monthLabel = byId<HTMLElement>("cal-month");
    const grid = byId<HTMLElement>("cal-grid");
    const prevBtn = byId<HTMLButtonElement>("cal-prev");
    const nextBtn = byId<HTMLButtonElement>("cal-next");
    const slotDay = byId<HTMLElement>("slot-day");
    const slotList = byId<HTMLElement>("slot-list");
    const submitBtn = byId<HTMLButtonElement>("booking-submit");
    const hint = byId<HTMLElement>("booking-hint");
    const meta = byId<HTMLElement>("booking-meta");
    const programmeInput = byId<HTMLInputElement>("booking-programme");
    const nameInput = byId<HTMLInputElement>("booking-name");
    const emailInput = byId<HTMLInputElement>("booking-email");
    const phoneInput = byId<HTMLInputElement>("booking-phone");
    const optIn = byId<HTMLInputElement>("booking-optin");

    // Step 2
    const payAmount = byId<HTMLElement>("pay-amount");
    const paySummary = byId<HTMLElement>("pay-summary");
    const payQr = byId<HTMLImageElement>("pay-qr");
    const payIntent = byId<HTMLAnchorElement>("pay-intent");
    const payCountdown = byId<HTMLElement>("pay-countdown");
    const payStatus = byId<HTMLElement>("pay-status");
    const mockPayBtn = byId<HTMLButtonElement>("mock-pay-btn");
    const utrForm = byId<HTMLFormElement>("utr-form");
    const utrInput = byId<HTMLInputElement>("utr-input");
    const utrSubmit = byId<HTMLButtonElement>("utr-submit");
    const utrError = byId<HTMLElement>("utr-error");

    // Step 3
    const doneSummary = byId<HTMLElement>("done-summary");
    const doneNote = byId<HTMLElement>("done-note");

    // ---------- Date helpers ----------
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const firstBookable = new Date(today);
    firstBookable.setDate(today.getDate() + MIN_DAYS_AHEAD);
    const monthNumber = (y: number, m: number) => y * 12 + m;
    const firstMonth = monthNumber(today.getFullYear(), today.getMonth());
    const lastMonth = firstMonth + MONTHS_SHOWN - 1;

    const isBookable = (d: Date) =>
      d >= firstBookable &&
      !CLOSED_WEEKDAYS.includes(d.getDay()) &&
      monthNumber(d.getFullYear(), d.getMonth()) <= lastMonth;

    const pad = (n: number) => String(n).padStart(2, "0");
    const isoDate = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const longDate = (d: Date) =>
      d.toLocaleDateString("en-US", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
    const shortDate = (d: Date) => d.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
    const fromIso = (iso: string) => new Date(`${iso}T00:00:00`);
    const describe = (hold: Hold) =>
      `${hold.programme} · ${longDate(fromIso(hold.date))} at ${formatTime(hold.time)} (India time)`;

    const findFirstAvailable = () => {
      const d = new Date(firstBookable);
      for (let i = 0; i < 120; i++) {
        if (isBookable(d)) return d;
        d.setDate(d.getDate() + 1);
      }
      return null;
    };

    const toWhatsAppNumber = (raw: string) => {
      const trimmed = raw.trim();
      if (trimmed.startsWith("+")) return "+" + trimmed.replace(/\D/g, "");
      const digits = trimmed.replace(/\D/g, "").replace(/^0+/, "");
      if (digits.length === 10) return "+91" + digits;
      return digits ? "+" + digits : "";
    };

    // ---------- State ----------
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();
    let selectedDate: Date | null = null;
    let selectedTime: string | null = null;
    let takenTimes: string[] = [];
    let loadingSlots = false;
    let currentHold: Hold | null = null;
    let pollTimer: number | undefined;
    let countdownTimer: number | undefined;

    // ---------- Switching views ----------
    const show = (view: "form" | "pay" | "done" | "expired") => {
      form.hidden = view !== "form";
      payView.hidden = view !== "pay";
      doneView.hidden = view !== "done";
      expiredView.hidden = view !== "expired";
    };

    const stopTimers = () => {
      window.clearInterval(countdownTimer);
      window.clearInterval(pollTimer);
    };

    // ---------- Calendar ----------
    const renderCalendar = () => {
      monthLabel.textContent = new Date(viewYear, viewMonth, 1)
        .toLocaleDateString("en-US", { month: "long", year: "numeric" });
      grid.replaceChildren();

      const offset = new Date(viewYear, viewMonth, 1).getDay();
      for (let i = 0; i < offset; i++) grid.append(document.createElement("span"));

      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(viewYear, viewMonth, day);
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = String(day);
        button.setAttribute("aria-label", longDate(date));
        button.disabled = !isBookable(date);
        button.setAttribute("aria-pressed", String(selectedDate?.getTime() === date.getTime()));
        button.addEventListener("click", () => selectDate(date));
        grid.append(button);
      }

      const current = monthNumber(viewYear, viewMonth);
      prevBtn.disabled = current <= firstMonth;
      nextBtn.disabled = current >= lastMonth;
    };

    // ---------- Time slots ----------
    const renderSlots = () => {
      slotList.replaceChildren();

      if (!selectedDate || loadingSlots) {
        slotDay.textContent = selectedDate ? shortDate(selectedDate) : "Choose a date";
        const message = document.createElement("p");
        message.className = "slot-empty";
        message.textContent = selectedDate ? "Checking available times…" : "Pick a day to see available times.";
        slotList.append(message);
        return;
      }

      slotDay.textContent = shortDate(selectedDate);
      for (const time of TIME_SLOTS) {
        const isTaken = takenTimes.includes(time);
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = formatTime(time);
        button.disabled = isTaken;
        if (isTaken) button.setAttribute("aria-label", `${formatTime(time)}, not available`);
        button.setAttribute("aria-pressed", String(time === selectedTime));
        button.addEventListener("click", () => {
          selectedTime = time;
          renderSlots();
          updateSubmit();
        });
        slotList.append(button);
      }
    };

    const updateSubmit = () => {
      submitBtn.disabled = !(selectedDate && selectedTime);
      if (!selectedDate) hint.textContent = "Select a date to continue";
      else if (!selectedTime) hint.textContent = "Select a time slot to continue";
      else hint.textContent = `${shortDate(selectedDate)} at ${formatTime(selectedTime)} (India time)`;
    };

    const selectDate = async (date: Date) => {
      selectedDate = date;
      selectedTime = null;
      takenTimes = [];
      loadingSlots = true;
      renderCalendar();
      renderSlots();
      updateSubmit();

      try {
        const response = await fetch(`${API}/availability?date=${isoDate(date)}`);
        if (response.ok) takenTimes = (await response.json()).taken ?? [];
      } catch {
        // the server double-checks when booking anyway
      }

      if (selectedDate === date) {
        loadingSlots = false;
        renderSlots();
      }
    };

    prevBtn.addEventListener("click", () => {
      viewMonth -= 1;
      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
      renderCalendar();
    });
    nextBtn.addEventListener("click", () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      renderCalendar();
    });

    optIn.addEventListener("change", () => { phoneInput.required = optIn.checked; });

    // ---------- Result screens ----------
    const showDone = (hold: Hold, verifying: boolean) => {
      stopTimers();
      doneSummary.textContent = describe(hold);
      doneNote.textContent = verifying ? "We'll verify your payment shortly and send your confirmation." : "";
      currentHold = null;
      show("done");
    };

    const showExpired = () => {
      stopTimers();
      currentHold = null;
      show("expired");
    };

    const resetToForm = () => {
      stopTimers();
      currentHold = null;
      show("form");
      submitBtn.disabled = true;
      const first = selectedDate ?? findFirstAvailable();
      if (first) {
        viewYear = first.getFullYear();
        viewMonth = first.getMonth();
        selectDate(first);
      }
    };

    // ---------- Step 1 → 2: hold the slot ----------
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!selectedDate || !selectedTime) return;

      submitBtn.disabled = true;
      hint.textContent = "Reserving your slot…";

      let response: Response;
      try {
        response = await fetch(`${API}/hold-slot`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            date: isoDate(selectedDate),
            time: selectedTime,
            name: nameInput.value,
            email: emailInput.value,
            whatsapp: optIn.checked ? toWhatsAppNumber(phoneInput.value) : phoneInput.value,
            whatsappOptIn: optIn.checked,
            programme: programmeInput.value,
          }),
        });
      } catch {
        hint.textContent = "Connection problem. Please check your internet and try again.";
        submitBtn.disabled = false;
        return;
      }

      let data: Record<string, any> = {};
      try { data = await response.json(); } catch { /* handled below */ }

      if (response.status === 409) {
        hint.textContent = data.error ?? "That slot was just taken. Please choose another time.";
        await selectDate(selectedDate);
        return;
      }
      if (!response.ok) {
        hint.textContent = data.error ?? `Something went wrong (error ${response.status}). Please try again.`;
        submitBtn.disabled = false;
        return;
      }

      currentHold = { ...(data as Hold), programme: programmeInput.value };
      await showPayment();
    });

    // ---------- Step 2: payment ----------
    const showPayment = async () => {
      if (!currentHold) return;
      const hold = currentHold;

      payAmount.textContent = `₹${hold.amount}`;
      paySummary.textContent = describe(hold);
      payIntent.href = hold.intentUrl;
      payStatus.textContent = "Waiting for payment…";
      utrInput.value = "";
      utrError.textContent = "";
      mockPayBtn.hidden = !import.meta.env.DEV;

      try {
        payQr.src = await QRCode.toDataURL(hold.qrData, {
          width: 440,
          margin: 1,
          color: { dark: "#1e2e20", light: "#ffffff" },
        });
      } catch {
        payQr.alt = "The QR code could not be created. Please use the 'Pay with UPI app' button.";
      }

      show("pay");
      startTimers();
    };

    const startTimers = () => {
      stopTimers();
      tickCountdown();
      countdownTimer = window.setInterval(tickCountdown, 1000);
      pollTimer = window.setInterval(checkStatus, 3000);
    };

    const tickCountdown = () => {
      if (!currentHold) return;
      const remaining = Math.max(0, currentHold.expiresAt - Date.now());
      payCountdown.textContent = `${Math.floor(remaining / 60000)}:${pad(Math.floor((remaining % 60000) / 1000))}`;
      if (remaining === 0) checkStatus();
    };

    // Asks the server: has it been paid (or a UTR submitted)?
    const checkStatus = async () => {
      if (!currentHold) return;
      const hold = currentHold;
      try {
        const response = await fetch(
          `${API}/booking-status?date=${hold.date}&time=${hold.time}&token=${hold.holdToken}`
        );
        if (!response.ok) return;
        const { status } = await response.json();
        if (status === "confirmed") showDone(hold, false);
        else if (status === "verifying") showDone(hold, true);
        else if (status === "expired") showExpired();
      } catch {
        // try again at the next check
      }
    };

    // The visitor submits their UPI transaction ID (UTR)
    utrForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!currentHold) return;
      const hold = currentHold;

      const utr = utrInput.value.replace(/\s/g, "");
      if (!/^\d{12}$/.test(utr)) {
        utrError.textContent = "Please enter the 12-digit number (UTR) from your payment app.";
        return;
      }

      utrError.textContent = "";
      utrSubmit.disabled = true;
      utrSubmit.textContent = "Submitting…";

      const resetButton = () => {
        utrSubmit.disabled = false;
        utrSubmit.textContent = "Submit Payment Details";
      };

      let response: Response;
      try {
        response = await fetch(`${API}/submit-utr`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ date: hold.date, time: hold.time, token: hold.holdToken, utr }),
        });
      } catch {
        utrError.textContent = "Connection problem. Please check your internet and try again.";
        resetButton();
        return;
      }

      let data: { error?: string; status?: string } = {};
      try { data = await response.json(); } catch { /* handled below */ }

      if (!response.ok) {
        utrError.textContent =
          data.error ?? `Something went wrong on our side (error ${response.status}). Please try again.`;
        resetButton();
        return;
      }

      resetButton();
      showDone(hold, data.status !== "confirmed");
    });

    // Test mode only: pretend the payment arrived
    mockPayBtn.addEventListener("click", async () => {
      if (!currentHold) return;
      payStatus.textContent = "Simulating payment…";
      try {
        await fetch(`${API}/mock-pay`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ orderId: currentHold.orderId }),
        });
      } catch {
        payStatus.textContent = "Simulation failed. Is netlify dev running?";
        return;
      }
      await checkStatus();
    });

    byId<HTMLButtonElement>("pay-back").addEventListener("click", () => {
      if (window.confirm("Choose a different time? This slot will be released automatically within 15 minutes.")) {
        resetToForm();
      }
    });
    byId<HTMLButtonElement>("expired-retry").addEventListener("click", resetToForm);

    // ---------- Opening the popup ----------
    document.addEventListener("click", (event) => {
      const link = (event.target as Element).closest('a[href="#book"]');
      if (!link) return;
      event.preventDefault();

      const fromAttribute = (link as HTMLElement).dataset.programme;
      const cardTitle = link.closest(".card")?.querySelector("h3")?.textContent?.trim();
      const programme = fromAttribute || cardTitle || DEFAULT_PROGRAMME;
      programmeInput.value = programme;
      meta.textContent = `${programme} · 45 min`;

      dialog.showModal();

      if (currentHold && Date.now() < currentHold.expiresAt) {
        show("pay");
        startTimers();
      } else if (form.hidden) {
        resetToForm();
      }
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => {
      stopTimers();
      if (!doneView.hidden || !expiredView.hidden) {
        form.reset();
        phoneInput.required = false;
        show("form");
      }
    });

    // ---------- Start ----------
    const first = findFirstAvailable();
    if (first) {
      viewYear = first.getFullYear();
      viewMonth = first.getMonth();
      selectDate(first);
    } else {
      renderCalendar();
      renderSlots();
    }
  }
</script>
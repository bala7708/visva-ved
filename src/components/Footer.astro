---
import { Image } from "astro:assets";
import logoWordmark from "../assets/images/logo-wordmark.png";

const email = "visvaved@gmail.com";

// Footer columns. "#" = page or link not decided yet (ask the client).
const columns = [
  {
    title: "Sacred Sciences",
    links: [
      { label: "Numerology Overview", href: "/numerology" },
      { label: "Core Numbers", href: "/numerology#core" },
      { label: "Name & Birth Analysis", href: "/numerology#discover" },
      { label: "Master Numbers", href: "/numerology#core" },
    ],
  },
  {
    title: "Tarot",
    links: [
      { label: "What is Tarot?", href: "/tarot" },
      { label: "Major Arcana", href: "/tarot#core" },
      { label: "Book a Reading", href: "#book" },
      { label: "Online Sessions", href: "#book" },
    ],
  },
  {
    title: "Vastu Shastra",
    links: [
      { label: "What is Vastu?", href: "/vastu" },
      { label: "The 8 Directions", href: "/vastu#core" },
      { label: "Home Consultation", href: "#book" },
      { label: "Elemental Mapping", href: "/vastu#discover" },
    ],
  },
  {
    title: "About",
    links: [
      { label: "Our Approach", href: "/#vedic" },
      { label: "Our Story", href: "/#vedic" },
      { label: "Testimonials", href: "/#vedic" },
      { label: "Contact Us", href: `mailto:${email}` },
    ],
  },
];

// Replace "#" with the client's real profile links (or delete a line they don't have)
const socials = [
  { label: "Instagram", href: "#" },
  { label: "Facebook", href: "#" },
  { label: "YouTube", href: "#" },
];

// "policy" opens the policy popup (PolicyModal.astro); href is the fallback page
const legal = [
  { label: "Privacy Policy", href: "/privacy#privacy", policy: "privacy" },
  { label: "Terms & Conditions", href: "/privacy#terms", policy: "terms" },
  { label: "Refund Policy", href: "/privacy#refund", policy: "refund" },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <!-- Brand column -->
      <div class="brand">
        <a href="/" class="wordmark" aria-label="Visva Ved, home">
          <Image src={logoWordmark} alt="" height={60} />
        </a>
        <p class="brand-text">Embrace your Highest Self</p>
        <a class="email" href={`mailto:${email}`}>✉ {email}</a>
        <ul class="socials">
          {socials.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="footer-title">{col.title}</h2>
          <ul class="footer-links">
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      <p>© {year} Visva Ved — Spiritual Coaching. All rights reserved.</p>
      <ul class="legal">
        {legal.map((link) => (
          <li><a href={link.href} data-policy={link.policy}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 64px 0 28px;
    background: var(--color-forest);
    font-family: var(--font-ui);
  }

  /* ---------- Top: brand + 4 link columns ---------- */
  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 32px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(201, 168, 76, 0.15);
  }

  /* "VISVA VED" lettering on a white plate, as in the design */
  .wordmark {
    display: inline-block;
    padding: 6px 10px;
    background: #ffffff;
    line-height: 0;
  }
  .wordmark :global(img) { width: auto; height: 22px; }

  .brand-text {
    max-width: 260px;
    margin-top: 28px;
    font-size: 1rem;
    line-height: 1.6;
    color: #f5efe2;
  }
  .email {
    display: inline-block;
    margin-top: 32px;
    font-size: 0.8125rem;
    color: var(--color-gold);
  }
  .email:hover { color: var(--color-cream); }

  .socials {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }
  .socials a { color: rgba(245, 239, 226, 0.6); transition: color 0.2s; }
  .socials a:hover { color: var(--color-gold); }

  /* Column headings: small gold Cinzel capitals */
  .footer-title {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    font-size: 0.8125rem;
    color: rgba(245, 239, 226, 0.6);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--color-gold); }

  /* ---------- Bottom row ---------- */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    font-size: 0.75rem;
    color: rgba(245, 239, 226, 0.45);
  }
  .legal {
    display: flex;
    gap: 24px;
    padding: 0;
    list-style: none;
  }
  .legal a:hover { color: var(--color-gold); }

  /* ---------- Tablet: brand on top, 4 columns ---------- */
  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: repeat(4, 1fr); }
    .brand { grid-column: 1 / -1; }
  }

  /* ---------- Phone: 2 columns, bottom row stacked ---------- */
  @media (max-width: 600px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 20px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .legal { flex-wrap: wrap; gap: 8px 20px; }
  }
</style>
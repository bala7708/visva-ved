---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";

// Footer columns. "#" = page or link not decided yet (ask the client).
const columns = [
  {
    title: "Sacred Sciences",
    links: [
      { label: "Numerology Overview", href: "/numerology" },
      { label: "Core Numbers", href: "/numerology#core" },
      { label: "Name & Birth Analysis", href: "/numerology#discover" },
      { label: "Master Numbers", href: "/numerology#core" },
    ],
  },
  {
    title: "Tarot",
    links: [
      { label: "What is Tarot?", href: "/tarot" },
      { label: "Major Arcana", href: "/tarot#core" },
      { label: "Book a Reading", href: "#book" },
      { label: "Online Sessions", href: "#book" },
    ],
  },
  {
    title: "Vastu Shastra",
    links: [
      { label: "What is Vastu?", href: "/vastu" },
      { label: "The 8 Directions", href: "/vastu#core" },
      { label: "Home Consultation", href: "#book" },
      { label: "Elemental Mapping", href: "/vastu#discover" },
    ],
  },
  {
    title: "Wisdom",
    links: [
      { label: "Articles", href: "/#wisdom" },
      { label: "Panch Mahabhutas", href: "#" },
      { label: "Vedic Philosophy", href: "/#vedic" },
      { label: "FAQ", href: "/#faq" },
    ],
  },
  {
    title: "About",
    links: [
      { label: "Our Approach", href: "/#vedic" },
      { label: "Our Story", href: "#" },
      { label: "Testimonials", href: "/#vedic" },
      { label: "Contact Us", href: "mailto:hello@visvaved.com" },
    ],
  },
];

const socials = [
  { label: "Instagram", href: "#" },
  { label: "Facebook", href: "#" },
  { label: "YouTube", href: "#" },
];

const legal = [
  { label: "Privacy Policy", href: "#" },
  { label: "Terms of Use", href: "#" },
  { label: "Cookie Policy", href: "#" },
];

const email = "hello@visvaved.com";   // confirm with the client
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <!-- Brand column -->
      <div class="brand">
        <Image src={logo} alt="Visva Ved" width={140} height={108} />
        <p class="brand-text">
          Rooted in timeless Vedic wisdom. Guiding you back to harmony through
          Numerology, Tarot, and Vastu Shastra.
        </p>
        <a class="email" href={`mailto:${email}`}>✉ {email}</a>
        <ul class="socials">
          {socials.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="footer-title">{col.title}</h2>
          <ul class="footer-links">
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      <p>© {year} Visva Ved — Spiritual Coaching. All rights reserved.</p>
      <ul class="legal">
        {legal.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 64px 0 28px;
    background: var(--color-forest);
    font-family: var(--font-ui);
  }

  /* ---------- Top: brand + 5 link columns ---------- */
  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr repeat(5, 1fr);
    gap: 32px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(201, 168, 76, 0.15);
  }

  .brand :global(img) {
    width: 70px;
    height: 54px;
    object-fit: contain;
  }
  .brand-text {
    max-width: 260px;
    margin-top: 16px;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: rgba(245, 239, 226, 0.7);
  }
  .email {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.8125rem;
    color: rgba(245, 239, 226, 0.85);
  }
  .email:hover { color: var(--color-gold); }

  .socials {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }
  .socials a { color: rgba(245, 239, 226, 0.6); transition: color 0.2s; }
  .socials a:hover { color: var(--color-gold); }

  /* Column headings: small gold Cinzel capitals */
  .footer-title {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    font-size: 0.8125rem;
    color: rgba(245, 239, 226, 0.6);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--color-gold); }

  /* ---------- Bottom row ---------- */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    font-size: 0.75rem;
    color: rgba(245, 239, 226, 0.45);
  }
  .legal {
    display: flex;
    gap: 24px;
    padding: 0;
    list-style: none;
  }
  .legal a:hover { color: var(--color-gold); }

  /* ---------- Tablet: brand on top, 3 columns ---------- */
  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: repeat(3, 1fr); }
    .brand { grid-column: 1 / -1; }
  }

  /* ---------- Phone: 2 columns, bottom row stacked ---------- */
  @media (max-width: 600px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 20px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .legal { flex-wrap: wrap; gap: 8px 20px; }
  }
</style>
---
const services = [
  { icon: "💼", label: "Job / Career / Business" },
  { icon: "📈", label: "Lucky Profession" },
  { icon: "🤝", label: "Partnerships – spouse / business" },
  { icon: "💍", label: "Marriage – delays / matchmaking / success" },
  { icon: "❤️", label: "Love / Arranged Marriage" },
  { icon: "✈️", label: "Foreign Settlements" },
  { icon: "📅", label: "Lucky C-section date" },
  { icon: "🔤", label: "Name analysis and balancing" },
  { icon: "👶", label: "Baby name / correction" },
  { icon: "✍️", label: "Signature Analysis" },
  { icon: "🚗", label: "Lucky colour / car / mobile number / house" },
  { icon: "🌟", label: "Predictions and Remedies" },
];
---

<section class="section services" aria-labelledby="services-title">
  <div class="container services-inner">
    <h2 id="services-title" class="sr-only">Numerology consultations for</h2>

    <ul class="services-list">
      {services.map((s) => (
        <li class="service">
          <span class="service-icon" aria-hidden="true">{s.icon}</span>
          <span>{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services { padding-block: 96px; }
  .services-inner { max-width: calc(862px + var(--gutter) * 2); }

  .services-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .service {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    padding: 12px 20px;
    background: #f8f3ea;
    border: 1px solid #ece2cf;
    border-radius: 12px;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .service-icon {
    flex-shrink: 0;
    font-size: 1.1rem;
  }

  @media (max-width: 700px) {
    .services { padding-block: 64px; }
    .services-list { grid-template-columns: 1fr; }
  }
</style>
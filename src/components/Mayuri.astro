---
// WhatsApp number in international format, without "+" or spaces
const whatsapp = "917208173256";
const display = "7208173256";
const enquiry = encodeURIComponent("Namaste Dr. Mayuri, I would like to know more about a session with Visva Ved.");
---

<section class="mayuri">
  <div class="mayuri-card">
    <div class="mayuri-left">
      <h2 class="mayuri-name">Dr. Mayuri</h2>
      <p class="mayuri-role">Certified Numerologist · Visva Ved</p>
      <a class="mayuri-phone" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 4.54 0 8.23 3.69 8.23 8.23 0 4.54-3.69 8.24-8.22 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/>
        </svg>
        {display}
      </a>
    </div>

    <div class="mayuri-right">
      <ul class="mayuri-words">
        <li>Clarity</li>
        <li>Guidance</li>
        <li>Positive Change</li>
      </ul>
      <a class="mayuri-btn" href={`https://wa.me/${whatsapp}?text=${enquiry}`} target="_blank" rel="noopener">
        Enquiry <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .mayuri {
    padding: 64px 24px;
    background: #ffffff;
  }

  .mayuri-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 40px 36px;
    border-radius: 18px;
    background: linear-gradient(110deg, #5cae6e 0%, #4f9562 50%, #3d6e48 100%);
    color: #ffffff;
  }

  .mayuri-name {
    margin: 0;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: 48px;
    line-height: 1.1;
    color: #f9f4ec;
  }

  .mayuri-role {
    margin: 6px 0 0;
    font-family: "Inter", sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.88);
  }

  .mayuri-phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 24px;
    color: #ffffff;
    text-decoration: none;
  }
  .mayuri-phone:hover { opacity: 0.85; }

  .mayuri-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .mayuri-words {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 10px;
    line-height: 1.7;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }

  .mayuri-btn {
    padding: 12px 26px;
    border-radius: 999px;
    background: #ffffff;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #2f5a3a;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .mayuri-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 700px) {
    .mayuri { padding: 48px 16px; }
    .mayuri-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
    }
    .mayuri-name { font-size: 38px; }
    .mayuri-phone { font-size: 20px; }
  }
</style>
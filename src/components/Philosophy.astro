---
import { Image } from "astro:assets";
import photo from "../assets/images/philosophy.jpg";
---

<section id="about" class="section">
  <div class="container philosophy">
    <!-- Left column: text -->
    <div class="philosophy-text">
      <p class="eyebrow">Our Philosophy</p>
      <h2>Where Ancient Wisdom Meets the Living Breath</h2>

      <p class="lead">
        VISVA VED — "the knowledge of all" — draws from the Vedic understanding
        that well-being is not the absence of suffering but the fullness of presence.
        Founded on the principle that the breath is the bridge between body and
        consciousness, we offer time-tested practices in their original integrity.
      </p>
      <p class="lead">
        Our retreats are held in sanctuaries of natural beauty — forest hermitages
        and mountain ashrams — where silence, simplicity, and sattvic living create
        the conditions for genuine inner shift.
      </p>

      <div class="actions">
        <a class="btn btn--primary" href="#programs">View All Courses</a>
        <a class="btn btn--outline" href="#stories">Read Stories</a>
      </div>
    </div>

    <!-- Right column: photo, lotus badge and quote card -->
    <div class="philosophy-media">
      <div class="media-card">
        <Image
          src={photo}
          alt="An ashram with temple domes surrounded by forest"
          widths={[480, 800, 1216]}
          sizes="(max-width: 900px) 100vw, 608px"
        />
      </div>

      <span class="badge" aria-hidden="true">🪷</span>

      <div class="quote-card">
        <p class="quote-title">"Breath is life."</p>
        <p class="quote-text">
          The Sudarshan Kriya™ is researched at Yale &amp; Harvard for its clinical efficacy.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Two equal columns with a 64px gap, vertically centered */
  .philosophy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  /* ---------- Text ---------- */
  h2 { margin-top: 16px; }

  .lead {
    margin-top: 24px;
    line-height: 1.625;
  }
  .lead + .lead { margin-top: 20px; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }

  /* ---------- Photo ---------- */
  .philosophy-media { position: relative; }

  .media-card {
    height: 490px;                 /* about the same height as the text column */
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-butter);   /* shows while the photo loads */
  }
  .media-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Gold circle with the lotus, overlapping the top-right corner */
  .badge {
    position: absolute;
    top: -16px;
    right: -16px;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-gold);
    font-size: 1.5rem;
    box-shadow: 0 8px 20px rgba(28, 15, 0, 0.15);
  }

  /* ---------- Quote card, overlapping the bottom-left corner ---------- */
  .quote-card {
    position: absolute;
    left: -24px;
    bottom: -24px;
    width: min(290px, 70%);
    padding: 24px;
    background: var(--color-sand);
    border: 1px solid rgba(184, 134, 11, 0.2);
    border-radius: var(--radius-card);
    box-shadow: 0 12px 32px rgba(28, 15, 0, 0.08);
  }
  .quote-title {
    font-family: var(--font-display);
    font-size: 1.375rem;           /* 22px */
    line-height: 1.3;
    color: var(--color-ink);
  }
  .quote-text {
    margin-top: 8px;
    font-weight: 400;
    font-size: 0.8125rem;          /* 13px */
    line-height: 1.6;
  }

  /* ---------- Tablet and phone: stack the columns ---------- */
  @media (max-width: 900px) {
    .philosophy {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .media-card { height: 440px; }
    .badge { right: 16px; }
    /* Keep the quote card inside the screen, overlapping the photo's bottom edge */
    .quote-card {
      left: 16px;
      bottom: -32px;
    }
    .philosophy-media { margin-bottom: 32px; }   /* room for the overlapping card */
  }
  @media (max-width: 600px) {
    .media-card { height: 340px; }
    .quote-card {
      width: calc(100% - 32px);
      padding: 20px;
    }
  }
</style>
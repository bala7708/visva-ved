---
// Popup for Terms, Privacy and Refund policies.
// Open it from any link or button with data-policy="terms" | "privacy" | "refund".
// Example: <a href="/privacy#privacy" data-policy="privacy">Privacy Policy</a>
// Without JavaScript the link still opens the /privacy page.
import PolicyContent from "./PolicyContent.astro";
---

<dialog class="policy-modal" data-policy-modal aria-labelledby="policy-modal-title">
  <header class="pm-head">
    <h2 id="policy-modal-title" class="pm-title">Policies</h2>
    <button type="button" class="pm-close" data-policy-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </header>

  <div class="pm-tabs" role="tablist" aria-label="Policies">
    <button type="button" role="tab" class="pm-tab" data-policy-tab="terms">Terms &amp; Conditions</button>
    <button type="button" role="tab" class="pm-tab" data-policy-tab="privacy">Privacy Policy</button>
    <button type="button" role="tab" class="pm-tab" data-policy-tab="refund">Refund Policy</button>
  </div>

  <div class="pm-body" data-policy-body tabindex="0">
    <PolicyContent />
  </div>

  <footer class="pm-foot">
    <button type="button" class="pm-ok" data-policy-close>I understand</button>
  </footer>
</dialog>

<style>
  .policy-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(760px, calc(100% - 32px));
    height: min(720px, calc(100dvh - 32px));
    padding: 0;
    border: 0;
    border-radius: 20px;
    background: #fffdf8;
    color: #3b3b33;
    box-shadow: 0 24px 60px rgba(20, 30, 20, 0.25);
    overflow: hidden;
  }
  .policy-modal[open] {
    display: flex;
    flex-direction: column;
  }
  .policy-modal::backdrop {
    background: rgba(20, 28, 20, 0.55);
    backdrop-filter: blur(2px);
  }

  .pm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px 12px;
  }
  .pm-title {
    margin: 0;
    font-family: "Cinzel", Georgia, serif;
    font-weight: 600;
    font-size: 20px;
    color: #5a7a5a;
  }
  .pm-close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid #e6dcc4;
    border-radius: 50%;
    background: transparent;
    color: #5a7a5a;
    cursor: pointer;
  }
  .pm-close:hover { border-color: #d4a840; color: #8a6a1f; }

  .pm-tabs {
    display: flex;
    gap: 8px;
    padding: 0 24px 14px;
    border-bottom: 1px solid #eee4cc;
    overflow-x: auto;
  }
  .pm-tab {
    flex: none;
    padding: 8px 16px;
    border: 1px solid #e6dcc4;
    border-radius: 999px;
    background: transparent;
    font-family: "Poppins", system-ui, sans-serif;
    font-size: 14px;
    color: #5a7a5a;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .pm-tab:hover { border-color: #d4a840; }
  .pm-tab[aria-selected="true"] {
    border-color: #d3a940;
    background: #d3a940;
    color: #ffffff;
  }

  .pm-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    overscroll-behavior: contain;
  }
  .pm-body:focus-visible { outline: 2px solid #d4a840; outline-offset: -2px; }

  /* Show only the chosen policy inside the popup */
  .pm-body :global([data-policy-section]) { display: none; }
  .pm-body :global([data-policy-section].is-active) { display: block; }
  .pm-body :global(.policy + .policy) { margin-top: 0; }

  .pm-foot {
    display: flex;
    justify-content: flex-end;
    padding: 14px 24px 18px;
    border-top: 1px solid #eee4cc;
  }
  .pm-ok {
    padding: 10px 26px;
    border: 0;
    border-radius: 999px;
    background: #e8892c;
    font-family: "Poppins", system-ui, sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #ffffff;
    cursor: pointer;
    transition: transform 0.25s ease;
  }
  .pm-ok:hover { transform: translateY(-2px) scale(1.04); }

  .pm-close:focus-visible,
  .pm-tab:focus-visible,
  .pm-ok:focus-visible { outline: 2px solid #d4a840; outline-offset: 3px; }

  @media (max-width: 600px) {
    .policy-modal { border-radius: 16px; }
    .pm-head, .pm-body { padding-left: 18px; padding-right: 18px; }
    .pm-tabs { flex-wrap: wrap; gap: 6px; padding-left: 18px; padding-right: 18px; }
    .pm-tab { padding: 7px 12px; font-size: 13px; }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>("[data-policy-modal]");

  if (modal) {
    const body = modal.querySelector<HTMLElement>("[data-policy-body]")!;
    const tabs = modal.querySelectorAll<HTMLButtonElement>("[data-policy-tab]");
    const sections = modal.querySelectorAll<HTMLElement>("[data-policy-section]");
    const valid = ["terms", "privacy", "refund"];

    const show = (name: string) => {
      const which = valid.includes(name) ? name : "privacy";
      sections.forEach((s) => s.classList.toggle("is-active", s.dataset.policySection === which));
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.policyTab === which)));
      body.scrollTop = 0;
    };

    const open = (name: string) => {
      show(name);
      if (!modal.open) modal.showModal();   // also works on top of the booking popup
    };

    // Any element with data-policy="..." opens the popup (footer, booking form, etc.)
    document.addEventListener("click", (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>("[data-policy]");
      if (!trigger) return;
      event.preventDefault();
      open(trigger.dataset.policy || "privacy");
    });

    tabs.forEach((tab) => tab.addEventListener("click", () => show(tab.dataset.policyTab || "privacy")));

    modal.querySelectorAll("[data-policy-close]").forEach((btn) =>
      btn.addEventListener("click", () => modal.close())
    );

    // Click on the dark backdrop closes it
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  }
</script>

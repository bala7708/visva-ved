---
import { Image } from "astro:assets";
import hero1 from "../assets/images/hero/hero-1.jpg";
import hero2 from "../assets/images/hero/hero-2.jpg";
import hero3 from "../assets/images/hero/hero-3.jpg";

// The banner photos, in order. To add or change one, edit this list.
const slides = [
  { image: hero1, alt: "Misty green valley with waterfalls" },
  { image: hero2, alt: "Sunset over a sea of clouds and snowy peaks" },
  { image: hero3, alt: "Misty hills under a sunrise sky" },
];
---

<section class="hero" data-hero aria-label="Visva Ved">
  <!-- Photos, stacked on top of each other; the active one is visible -->
  <div class="hero-slides">
    {slides.map((slide, i) => (
      <div class:list={["hero-slide", { "is-active": i === 0 }]} aria-hidden={i === 0 ? "false" : "true"}>
        <Image
          src={slide.image}
          alt={slide.alt}
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
      </div>
    ))}
  </div>

  <!-- Dark gradient over the photos, for readable text -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <h1 class="hero-title">
    <span class="line">Embrace</span>
    <span class="line line--italic">Your Highest</span>
    <span class="line">Self</span>
  </h1>

  <!-- Dots: show which photo is visible; click one to jump to it -->
  <div class="hero-dots">
    {slides.map((slide, i) => (
      <button
        type="button"
        class="hero-dot"
        data-dot={i}
        aria-label={`Show photo ${i + 1} of ${slides.length}`}
        aria-current={i === 0 ? "true" : "false"}
      ></button>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    height: 659px;
    padding: 0 24px;
    overflow: hidden;
    background: #1b2a1e;
    text-align: center;
  }

  /* ---------- Slides ---------- */
  .hero-slides,
  .hero-overlay {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }
  .hero-slide.is-active { opacity: 1; }

  .hero-slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 4s ease-out;
  }
  /* Slow, gentle zoom on the visible photo */
  .hero-slide.is-active :global(img) { transform: scale(1.06); }

  .hero-overlay {
    background: linear-gradient(180deg, rgba(10, 16, 12, 0.08) 0%, rgba(10, 16, 12, 0.4) 100%);
  }

  /* ---------- Heading ---------- */
  .hero-title {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 1.05;
    color: #f9f4ec;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.55);
  }
  .line { display: block; }
  .line--italic {
    font-style: italic;
    color: #ffffff;
  }

  /* ---------- Dots ---------- */
  .hero-dots {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 28px;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .hero-dot[aria-current="true"] {
    width: 26px;
    background: #d4a840;
  }
  .hero-dot:focus-visible {
    outline: 2px solid #d4a840;
    outline-offset: 3px;
  }

  /* Visitors who prefer less motion: no zoom, instant change */
  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-slide :global(img) { transition: none; }
    .hero-slide.is-active :global(img) { transform: none; }
  }

  @media (max-width: 600px) {
    .hero { height: 520px; }
    .hero-dots { bottom: 20px; }
  }
</style>

<script>
  const SLIDE_SECONDS = 3;   // how long each photo shows

  const hero = document.querySelector<HTMLElement>("[data-hero]");

  if (hero) {
    const slides = hero.querySelectorAll<HTMLElement>(".hero-slide");
    const dots = hero.querySelectorAll<HTMLButtonElement>("[data-dot]");

    let current = 0;
    let timer: number | undefined;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;   // after the last photo, back to the first
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === current);
        slide.setAttribute("aria-hidden", String(i !== current));
      });
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === current)));
    };

    const start = () => {
      window.clearInterval(timer);
      if (slides.length > 1) {
        timer = window.setInterval(() => show(current + 1), SLIDE_SECONDS * 1000);
      }
    };

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        show(i);
        start();   // count 3 seconds again from this photo
      })
    );

    start();
  }
</script>
---
import { getImage } from "astro:assets";
import posterImage from "../assets/images/hero-home.jpg";

// The still photo: shown while the video loads, if it's missing,
// and for visitors who prefer reduced motion
const poster = await getImage({ src: posterImage, width: 1920, format: "webp" });
---

<section class="hero">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster.src}
    aria-hidden="true"
    data-hero-video
  >
    <source src="/videos/hero.mp4" type="video/mp4" />
  </video>

  <!-- Dark gradient over the video, for readable text -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <h1 class="hero-title">
    <span class="line">Embrace</span>
    <span class="line line--gold">Your Highest</span>
    <span class="line">Self</span>
  </h1>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    height: 659px;
    padding: 0 var(--gutter);
    overflow: hidden;
    background: #1b2a1e;          /* shows for a moment before the photo or video loads */
    text-align: center;
  }

  .hero-video,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-video { object-fit: cover; }

  /* Figma: a linear gradient at 60% over the video */
  .hero-overlay {
    background: linear-gradient(180deg, rgba(10, 16, 12, 0.1) 0%, rgba(10, 16, 12, 0.55) 100%);
    opacity: 0.6;
  }

  .hero-title {
    position: relative;           /* above the video and overlay */
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 6.5rem);   /* 104px on desktop */
    line-height: 1.05;
    color: #f9f4ec;
    text-shadow: 10px 4px 144px rgba(0, 0, 0, 0.9);
  }
  .line { display: block; }
  .line--gold {
    font-family: "Faculty Glyphic", Georgia, serif;
    color: #d4a840;
  }

  @media (max-width: 600px) {
    .hero { height: 520px; }
  }
</style>

<script>
  // Visitors who turned on "reduce motion" see the still photo instead of the moving video
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.pause();
    video.removeAttribute("autoplay");
  }
</script>
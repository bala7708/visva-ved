---
const steps = [
  {
    title: "Problem Statement",
    text: "Every journey towards the light begins with a question that articulates an unease. Naming this problem is a profound act of clarity in itself!",
  },
  {
    title: "Diagnosis",
    text: "We apply a scientific lens in unveiling underlying disharmonies, vibrational codes and symbolic currents that illuminate the trouble areas.",
  },
  {
    title: "Analysis",
    text: "We take a deep dive into karmic cycles and life paths, exploring patterns and archetypal narratives of the past, present and future.",
  },
  {
    title: "Remedial Interventions",
    text: "Wisdom crystallises into prescriptions offering subtle corrections, reflective counsel and pathways towards holistic wellbeing for enlightened living!",
  },
];
---

<section class="jr">
  <div class="jr-inner">
    <h2 class="jr-title">Journey Towards Your Transformation</h2>
    <p class="jr-eyebrow">The Visva Ved Process</p>

    <figure class="jr-quote">
      <blockquote><p>“Until you make the unconscious conscious, it will direct your life and you will call it fate.”</p></blockquote>
      <figcaption>Carl Jung, 1906</figcaption>
    </figure>

    <ol class="jr-steps">
      {steps.map((step, i) => (
        <li class={`jr-step ${i % 2 === 0 ? "jr-step--left" : "jr-step--right"}`}>
          <span class="jr-num" aria-hidden="true">{i + 1}</span>
          <div class="jr-card">
            <p class="jr-step-label">Step {String(i + 1).padStart(2, "0")}</p>
            <h3 class="jr-step-title">{step.title}</h3>
            <p class="jr-step-text">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <span class="jr-end" aria-hidden="true"></span>

    <a class="btn btn--saffron jr-btn" href="#book">
      Begin Your Transformation <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .jr {
    padding: 96px 24px;
    background: #ffffff;
    text-align: center;
  }

  .jr-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .jr-title {
    margin: 0;
    font-family: "Cinzel", serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 45px;
    color: #5a7a5a;
  }

  .jr-eyebrow {
    margin: 2px 0 0;
    font-family: "Cinzel", serif;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a84c;
  }

  .jr-quote { margin: 28px 0 0; }
  .jr-quote blockquote { margin: 0; }
  .jr-quote p {
    margin: 0;
    font-family: "Lora", serif;
    font-style: italic;
    font-size: 14px;
    color: #4a5e4b;
  }
  .jr-quote figcaption {
    margin-top: 10px;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #9a9d90;
  }

  /* ---------- The timeline ---------- */
  .jr-steps {
    position: relative;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  /* The vertical line through the middle */
  .jr-steps::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(to bottom, #e9dcb4, #c9a84c 30%, #9fc3a6 100%);
    transform: translateX(-50%);
  }

  .jr-step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1fr);
    align-items: center;
    margin-top: -40px;          /* steps overlap like the design's zig-zag */
  }
  .jr-step:first-child { margin-top: 0; }

  .jr-num {
    grid-column: 2;
    grid-row: 1;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: 0 auto;
    border: 1px solid #c9a84c;
    border-radius: 50%;
    background: #fbf6ea;
    box-shadow: 0 0 0 4px #ffffff;
    font-family: "Cinzel", serif;
    font-size: 11px;
    color: #a8872f;
  }

  .jr-card {
    grid-row: 1;
    padding: 22px 20px;
    background: #ffffff;
    border: 1px solid #e3dccb;
    box-shadow: 0 4px 14px rgba(30, 46, 32, 0.04);
  }
  .jr-step--left .jr-card { grid-column: 1; }
  .jr-step--right .jr-card { grid-column: 3; }

  .jr-step-label {
    margin: 0;
    font-family: "Cinzel", serif;
    font-size: 8px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a84c;
  }

  .jr-step-title {
    margin: 6px 0 0;
    font-family: "Cinzel", serif;
    font-weight: 600;
    font-size: 16px;
    color: #c9a84c;
  }

  .jr-step-text {
    margin: 10px 0 0;
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    line-height: 1.7;
    color: #6b7a6c;
  }

  .jr-end {
    display: block;
    width: 8px;
    height: 8px;
    margin: 20px auto 0;
    border-radius: 50%;
    background: #c9a84c;
    box-shadow: 0 0 0 4px #f3ead2;
  }

  .jr-btn { margin-top: 56px; }

  /* ---------- Phone: line on the left, all cards on the right ---------- */
  @media (max-width: 700px) {
    .jr { padding: 72px 16px; }
    .jr-title { font-size: 26px; line-height: 36px; }

    .jr-steps::before { left: 16px; }
    .jr-step {
      grid-template-columns: 32px minmax(0, 1fr);
      column-gap: 16px;
      margin-top: 20px;
    }
    .jr-num { grid-column: 1; margin: 0; }
    .jr-step--left .jr-card,
    .jr-step--right .jr-card { grid-column: 2; }
    .jr-end { margin-left: 12px; }
  }
</style>
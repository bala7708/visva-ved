---
// Client testimonials. To add one, copy a { … } block and change the text.
// "initials" is what shows in the gold circle.
const stories = [
  {
    quote: "My experience with Dr. Mayuri's Tarot Reading was truly wonderful and enlightening. The readings were insightful, personalized, and helped me gain a deeper understanding of myself and different aspects of my life. I'd definitely recommend it to anyone looking for a little clarity, reassurance, or guidance in life!",
    name: "Pandit",
    initials: "PN",
  },
  {
    quote: "My Numerology session with Dr. Mayuri was eye-opening. Her guidance was thoughtful, compassionate, and full of positive energy. The session gave me clarity, a fresh perspective, and greater confidence in moving forward. I highly recommend Dr. Mayuri to anyone seeking spiritual guidance, self-discovery, and personal growth!",
    name: "Ms. Chitra",
    initials: "MC",
  },
  {
    quote: "An amazing, deeply personal experience! It gave me the reassurance and clarity I needed, and things are already unfolding just as described. Definitely give her tarot session a try!",
    name: "Dr. Priyanka",
    initials: "DP",
  },
  {
    quote: "I'm so glad I tried this! The numerology reading was incredibly accurate and spot-on for what I'm going through. I walked away with total clarity, peace of mind, and direction. Highly recommended for guidance!",
    name: "Mrs. Patil",
    initials: "MP",
  },
  {
    quote: "The guidance I received was absolutely spot-on. The session helped me understand exactly where I was stuck and what was wrong. The name balancing process was highly eye-opening, and I'm already experiencing fantastic results in my daily life!",
    name: "Mr. Utkarsh",
    initials: "MU",
  },
];
---

<section class="stories" aria-labelledby="stories-title" data-stories>
  <div class="stories-head">
    <h2 id="stories-title" class="stories-title">Stories of Becoming</h2>
  </div>

  <ul class="stories-track" tabindex="0" aria-label="Testimonials, scroll sideways for more" data-track>
    {stories.map((s) => (
      <li class="story">
        <blockquote class="story-quote"><p>“{s.quote}”</p></blockquote>
        <div class="story-person">
          <span class="story-avatar" aria-hidden="true">{s.initials}</span>
          <p class="story-name">{s.name}</p>
        </div>
      </li>
    ))}
  </ul>

  <!-- Slider controls: arrows + a bar showing (and changing) the position -->
  <div class="stories-controls">
    <button type="button" class="stories-arrow" data-prev aria-label="Previous testimonials">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>

    <div class="stories-bar" data-bar aria-hidden="true">
      <span class="stories-thumb" data-thumb></span>
    </div>

    <button type="button" class="stories-arrow" data-next aria-label="Next testimonials">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </button>
  </div>
</section>

<style>
  .stories {
    padding: 72px 0 80px;
    background: #f7f1e1;
    overflow: hidden;
  }

  .stories-head {
    padding: 0 24px;
    text-align: center;
  }

  .stories-title {
    margin: 0;
    font-family: "Cinzel", serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 45px;
    color: #5a7a5a;
  }

  /* A row of cards that slides sideways (swipe, drag, arrows or the bar) */
  .stories-track {
    display: flex;
    gap: 24px;
    margin: 40px 0 0;
    padding: 8px max(24px, calc((100vw - 1148px) / 2)) 24px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(24px, calc((100vw - 1148px) / 2));
    scroll-behavior: smooth;
    scrollbar-width: none;
    cursor: grab;
  }
  .stories-track::-webkit-scrollbar { display: none; }
  .stories-track.is-dragging { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; user-select: none; }
  .stories-track:focus-visible { outline: 2px solid #c9a84c; outline-offset: 4px; }

  .story {
    flex: 0 0 min(340px, 82vw);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    min-height: 196px;
    padding: 32px 20px 24px;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(30, 46, 32, 0.08);
  }

  .story-quote { flex: 1; margin: 0; }
  .story-quote p {
    margin: 0;
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    line-height: 1.75;
    color: #3b2a1a;
  }

  .story-person {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }

  .story-avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #b8860b;
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 11px;
    color: #ffffff;
  }

  .story-name {
    margin: 0;
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: #1e2e20;
  }

  /* ---------- Slider controls ---------- */
  .stories-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: min(420px, calc(100% - 48px));
    margin: 16px auto 0;
  }

  .stories-arrow {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid #d9c9a3;
    border-radius: 50%;
    background: #ffffff;
    color: #5a7a5a;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
  }
  .stories-arrow:hover:not(:disabled) { border-color: #b8860b; background: #b8860b; color: #ffffff; }
  .stories-arrow:disabled { opacity: 0.35; cursor: default; }
  .stories-arrow:focus-visible { outline: 2px solid #c9a84c; outline-offset: 3px; }

  .stories-bar {
    position: relative;
    flex: 1;
    height: 4px;
    border-radius: 999px;
    background: #e6dcc4;
    cursor: pointer;
    touch-action: none;
  }
  .stories-bar::before {
    content: "";
    position: absolute;
    inset: -10px 0;
  }
  .stories-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 999px;
    background: #b8860b;
  }

  /* Everything fits on screen: no slider needed */
  .stories.is-static .stories-controls { display: none; }
  .stories.is-static .stories-track { cursor: default; }

  @media (max-width: 600px) {
    .stories-title { font-size: 26px; line-height: 36px; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-stories]");

  if (section) {
    const track = section.querySelector<HTMLElement>("[data-track]")!;
    const bar = section.querySelector<HTMLElement>("[data-bar]")!;
    const thumb = section.querySelector<HTMLElement>("[data-thumb]")!;
    const prev = section.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = section.querySelector<HTMLButtonElement>("[data-next]")!;

    const maxScroll = () => track.scrollWidth - track.clientWidth;
    const step = () => {
      const card = track.querySelector<HTMLElement>(".story");
      return card ? card.offsetWidth + 24 : track.clientWidth * 0.8;
    };

    // Move the gold thumb to match the scroll position
    const update = () => {
      const max = maxScroll();
      section.classList.toggle("is-static", max <= 2);
      const visible = track.clientWidth / track.scrollWidth;
      const thumbWidth = Math.max(visible * 100, 12);
      const progress = max > 0 ? track.scrollLeft / max : 0;
      thumb.style.width = `${thumbWidth}%`;
      thumb.style.left = `${progress * (100 - thumbWidth)}%`;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));

    // Click or drag on the bar to slide
    const scrollFromBar = (clientX: number) => {
      const rect = bar.getBoundingClientRect();
      const ratio = Math.min(Math.max((clientX - rect.left) / rect.width, 0), 1);
      track.scrollTo({ left: ratio * maxScroll(), behavior: "auto" });
    };
    bar.addEventListener("pointerdown", (event) => {
      bar.setPointerCapture(event.pointerId);
      track.style.scrollSnapType = "none";
      scrollFromBar(event.clientX);
      const move = (e: PointerEvent) => scrollFromBar(e.clientX);
      const up = () => {
        track.style.scrollSnapType = "";
        bar.removeEventListener("pointermove", move);
      };
      bar.addEventListener("pointermove", move);
      bar.addEventListener("pointerup", up, { once: true });
      bar.addEventListener("pointercancel", up, { once: true });
    });

    // Drag the cards sideways with the mouse (phones already swipe)
    let dragStartX = 0;
    let dragStartScroll = 0;
    let dragging = false;
    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      dragging = true;
      dragStartX = event.clientX;
      dragStartScroll = track.scrollLeft;
      track.classList.add("is-dragging");
    });
    window.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      track.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
    });
    window.addEventListener("pointerup", () => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove("is-dragging");
    });

    // Arrow keys when the row has keyboard focus
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") { event.preventDefault(); track.scrollBy({ left: step() }); }
      if (event.key === "ArrowLeft") { event.preventDefault(); track.scrollBy({ left: -step() }); }
    });

    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
---
// The content of the four cards. Edit this list to change the cards.
const benefits = [
  {
    icon: "🌬️",
    title: "Breath as Medicine",
    text: "Rhythmic breathing techniques clinically shown to reduce cortisol by up to 56% and elevate serotonin naturally.",
  },
  {
    icon: "🧠",
    title: "Mental Clarity",
    text: "Quiet the mind's noise. Regular practice sharpens focus, improves memory, and dissolves mental fog.",
  },
  {
    icon: "❤️",
    title: "Emotional Harmony",
    text: "Release stored trauma, anxiety, and grief through proven somatic techniques anchored in ancient wisdom.",
  },
  {
    icon: "✨",
    title: "Awakened Vitality",
    text: "Practitioners report deeper sleep, elevated energy, and a sustained sense of joy within the first week.",
  },
];
---

<section class="section science">
  <div class="container science-inner">
    <header class="science-heading">
      <p class="eyebrow">Why It Works</p>
      <h2>The Science of Transformation</h2>
    </header>

    <ul class="cards">
      {benefits.map((item) => (
        <li class="card">
          <span class="card-icon" aria-hidden="true">{item.icon}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .science {
    background: var(--color-sand);
    /* 96px on desktop (from Figma), but never more than the smaller mobile spacing */
    padding-block: min(var(--section-pad), 96px);
  }

  .science-inner { max-width: calc(1152px + var(--gutter) * 2); }

  /* ---------- Heading ---------- */
  .science-heading { text-align: center; }
  h2 {
    margin-top: 12px;
    font-size: clamp(2rem, 3.5vw, 3rem);   /* 48px on desktop */
  }

  /* ---------- Cards ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);  /* four equal columns */
    gap: 24px;
    margin-top: 64px;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 32px;
    background: var(--color-cream);
    border: 1px solid rgba(184, 134, 11, 0.12);
    border-radius: var(--radius-card);
  }

  .card-icon {
    display: block;
    font-size: 2.25rem;     /* 36px */
    line-height: 1.1;
  }

  h3 {
    margin-top: 20px;
    font-size: 1.25rem;     /* 20px */
    line-height: 1.4;
  }

  .card p {
    margin-top: 12px;
    font-size: 0.875rem;    /* 14px */
    line-height: 1.625;
  }

  /* ---------- Tablet: 2 × 2 ---------- */
  @media (max-width: 1024px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---------- Phone: one card per row ---------- */
  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 40px;
    }
    .card { padding: 24px; }
  }
</style>
---
import ServicePage from "../components/ServicePage.astro";
import heroPhoto from "../assets/images/pages/vastu-hero.jpg";
import introPhoto from "../assets/images/pages/vastu-intro.jpg";

const page = {
  title: "Vastu Shastra | Visva Ved",
  description: "Every building is a microcosm of the universe — aligning human life with Earth's geomagnetic field, solar cycles, and the five great elements.",

  hero: {
    eyebrow: "Sacred Architecture",
    title: "Vastu Shastra",
    subtitle: "Every building is a microcosm of the universe — aligning human life with Earth's geomagnetic field, solar cycles, and the Panch Mahadhatus.",
    image: heroPhoto,
    tint: "#2b2414",
    opacity: 0.75,
    shade: true,
  },

  intro: {
    eyebrow: "Sthapatya Veda",
    title: "Your Home as a Cosmic Sanctuary",
    paragraphs: [
      "Vastu Shastra, the ancient Indian science of dwelling, rooted in the Sthapathya Veda, teaches that every life in this cosmic macrocosm is ruled by the five elements or Panch Mahadhatus — Earth, water, fire, air, space.",
      "When spaces are designed in resonance with these elements, they support health and prosperity, while mis-alignments create conflicts, disease and disappointments.",
      "Hence, the aim of Vedic Vastu is to balance these elements in our surroundings by aligning our activities, energies and directions with these cosmic forces and not the other way around.",
      "We at Visva Ved, seek to bust the myths and superstitions that surround the ancient science of Vastu Shastra and offer mindful yet scientific adjustments and lifestyle changes with a focus on achieving harmony with our environment to help make your home a sanctuary for self-elevation.",
    ],
    image: introPhoto,
    alt: "An ornate temple tower with carved figures against a cloudy sky",
    ratio: "4 / 5",
  },

  rooted: {
    title: "Rooted in the Sthapatya Veda",
    text: "Visva Ved delivers pure, unadulterated and time-tested VEDIC VASTU SHASTRA principles from ancient scriptures, so that you receive the uncompromised power of pure elemental science, engineered exactly as the sages intended — free from unwarranted mixing of modern spatial theories.",
  },

  core: {
    title: "Core Elements",
    variant: "elements" as const,
    items: [
      { name: "Health", subtitle: "mental, Physical, emotional", text: "Main door placement threatening your vitality?" },
      { name: "Career & Money", subtitle: "opportunities and savings", text: "Do you feel prosperity blocked at your doorstep?" },
      { name: "Relationships", subtitle: "Deep intimacy, mutual respect, bonding", text: "Bedroom placement destroying love?" },
    ],
  },

  faq: {
    title: "Vastu FAQ’s",
    items: [
      {
        question: "Is Vastu a religious practice?",
        answer: "No. It is a universal energy science based on magnetic fields, solar energy, wind directions, and elemental balance that applies to everyone, regardless of faith.",
      },
      {
        question: "Can Vastu fix my current life problems?",
        answer: "While it does not change your destiny, by balancing the energy of your space and allowing it to flow freely, unseen roadblocks are removed, stagnation is dissolved, paving the way for better health, clearer thinking, and financial growth.",
      },
      {
        question: "Do I need to break down walls or do major demolition for a Vastu consultation?",
        answer: "No. At Visva Ved, we specialize in non-invasive, elemental remedies using colours, plants, fountains, crystals, and spatial realignment without structural damage.",
      },
      {
        question: "Do you provide Vastu guidance for buying a new home or office plot?",
        answer: "Yes. We analyse the land layout, soil energy, and directional alignment before you purchase to ensure you invest in a highly prosperous space.",
      },
      {
        question: "Do you offer online/virtual Vastu consultations?",
        answer: "Yes. We provide precise remote consultations globally using your accurate architectural floor plans, Google Earth data, and video walkthroughs.",
      },
    ],
  },
};
---

<ServicePage {...page} />
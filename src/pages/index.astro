---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Seeking from "../components/Seeking.astro";
import Stats from "../components/Stats.astro";
import Paths from "../components/Paths.astro";
import Wisdom from "../components/Wisdom.astro";
import Rooted from "../components/Rooted.astro";
import Faq from "../components/Faq.astro";
import Services from "../components/Services.astro";
import Articles from "../components/Articles.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import BookingModal from "../components/BookingModal.astro";
---

<BaseLayout>
